unit g.gobject;

uses ffi;

type gobject_repository;

fn gobject_lib~cache : ffi_library;
fn glib_lib~cache : ffi_library;
fn gio_lib~cache : ffi_library;

type fn_callback := fn(w : world, repo : gobject_repository, u : ffi_callback) : (world, gobject_repository, int);

record gobject_repository [
	destr : ffi_destructor;
	use_thread : bool;
	thr : ffi_thread;
	callbacks : list(fn_callback);
	destructors : list(ffi_destructor);
]

fn ffi_function_create_multiple(libraries : list(ffi_library), funcname : bytes, flags : int, nvarargs : int, rtype : ffi_type, args : list(ffi_type)) : ffi_function;

fn gobject_repository_init(implicit w : world, use_thread : bool) : (world, gobject_repository);

type gpointer;

fn gpointer_from_ptr(ptr : int) : gpointer;
fn gpointer_ptr(gptr : gpointer) : int;

type gobject;

fn gobject_init(implicit w : world, implicit repo : gobject_repository, func : ffi_function, args : list(int)) : (world, gobject);
fn gobject_init_with_unref(implicit w : world, implicit repo : gobject_repository, func : ffi_function, args : list(int), unref : ffi_function) : (world, gobject);
fn gobject_from_ptr(ptr : int) : gobject;
fn gobject_ptr(gobj : gobject) : int;
fn gobject_keep(w : world, gobj : gobject) : world;

fn g_free(implicit w : world, ptr : int) : world;

fn g_signal_connect(implicit w : world, implicit repo : gobject_repository, gobj : gobject, name : bytes, data : int, flags : int, ret : ffi_type, args : list(ffi_type), f : fn_callback) : (world, gobject_repository);

type gtimer;
const G_PRIORITY_HIGH := -100;
const G_PRIORITY_DEFAULT := 0;
const G_PRIORITY_HIGH_IDLE := 100;
const G_PRIORITY_DEFAULT_IDLE := 200;
const G_PRIORITY_LOW := 300;
fn g_timer_connect(implicit w : world, implicit repo : gobject_repository, priority : int, interval : int, data : int, f : fn_callback) : (world, gobject_repository, gtimer);
fn g_idle_connect(implicit w : world, implicit repo : gobject_repository, priority : int, data : int, f : fn_callback) : (world, gobject_repository, gtimer);

fn g_application_run(implicit w : world, implicit repo : gobject_repository, app : gobject, appname : string, args : list(bytes)) : (world, gobject_repository, int);

implementation

uses charset;

fn gobject_lib~cache := ffi_open_library("gobject-2.0", true, "", 0);
fn glib_lib~cache := ffi_open_library("glib-2.0", true, "", 0);
fn gio_lib~cache := ffi_open_library("gio-2.0", true, "", 0);

fn ffi_function_create_multiple(libraries : list(ffi_library), funcname : bytes, flags : int, nvarargs : int, rtype : ffi_type, args : list(ffi_type)) : ffi_function
[
	if not len_greater_than(libraries, 0) then
		abort;
	var i := 0;
again:
	var ffn := ffi_function_create(libraries[i], funcname, flags, nvarargs, rtype, args);
	if not is_exception ffn then
		return ffn;
	if i + 1 < len(libraries) then [
		i += 1;
		goto again;
	]
	return ffn;
]

fn gobject_repository_init(implicit w : world, use_thread : bool) : (world, gobject_repository)
[
	var destr := ffi_destructor_new();
	var callbacks := infinite_uninitialized(fn_callback);
	var destructors := infinite_uninitialized(ffi_destructor);
	var repo := gobject_repository.[
		destr : destr,
		use_thread : use_thread,
		callbacks : callbacks,
		destructors : destructors,
	];
	repo.thr := ffi_thread_spawn();
	return repo;
]

type gpointer := int;

fn gpointer_from_ptr(ptr : int) : gpointer := ptr;
fn gpointer_ptr(gptr : gpointer) : int := gptr;

record gobject [
	ptr : int;
	destr : ffi_destructor;
]

fn gobject_init(implicit w : world, implicit repo : gobject_repository, func : ffi_function, args : list(int)) : (world, gobject)
[
	var ptr : int;
	var r e : int;
	var destr := ffi_destructor_new();
	if repo.use_thread then
		ptr, e := ffi_thread_sync_call(repo.thr, destr, func, args);
	else
		ptr, e := ffi_function_call(func, args);
	if ptr = 0 then [
		return gobject.[
			ptr : ptr,
		];
	]

	fn g_object_ref_sink~cache := ffi_function_prototype(gobject_lib, 0, "void *g_object_ref_sink(void *)");
	if repo.use_thread then
		r, e := ffi_thread_sync_call(repo.thr, destr, g_object_ref_sink, [ ptr ]);
	else
		r, e := ffi_function_call(g_object_ref_sink, [ ptr ]);
	fn g_object_unref~cache := ffi_function_prototype(gobject_lib, 0, "void g_object_unref(void *)");
	if repo.use_thread then
		ffi_thread_destructor_call(destr, repo.thr, g_object_unref, [ ptr ]);
	else
		ffi_destructor_call(destr, g_object_unref, [ ptr ]);
	return gobject.[
		ptr : ptr,
		destr : destr,
	];
]

fn gobject_init_with_unref(implicit w : world, implicit repo : gobject_repository, func : ffi_function, args : list(int), unref : ffi_function) : (world, gobject)
[
	var ptr : int;
	var r e : int;
	var destr := ffi_destructor_new();
	if repo.use_thread then
		ptr, e := ffi_thread_sync_call(repo.thr, destr, func, args);
	else
		ptr, e := ffi_function_call(func, args);
	if ptr = 0 then [
		return gobject.[
			ptr : ptr,
		];
	]

	ffi_destructor_call(destr, unref, [ ptr ]);
	return gobject.[
		ptr : ptr,
		destr : destr,
	];
]

fn gobject_from_ptr(ptr : int) : gobject
[
	return gobject.[
		ptr : ptr,
	];
]

fn gobject_ptr(gobj : gobject) : int
[
	return gobj.ptr;
]

fn gobject_keep(w : world, gobj : gobject) : world
[
	var w2 : world;
	pcode IO IO_Consume_Parameters 1 2 0 =w2 w gobj;
	return w2;
]

fn g_free(implicit w : world, ptr : int) : world
[
	fn g_free~cache := ffi_function_prototype(gobject_lib, 0, "void g_free(void *mem)");
	var r, e := ffi_function_call(g_free, [ ptr ]);
]

fn callback_disconnect(cb cb_destr : int, implicit w : world, implicit repo : gobject_repository, u : ffi_callback) : (world, gobject_repository, int)
[
	repo.callbacks[cb] := uninitialized(fn_callback);
	repo.callbacks[cb_destr] := uninitialized(fn_callback);
	repo.destructors[cb] := uninitialized(ffi_destructor);
	//eval debug("disconnecting " + ntos_base(cb, 16) + ", " + ntos_base(cb_destr, 16));
	return 0;
]

fn g_signal_connect(implicit w : world, implicit repo : gobject_repository, gobj : gobject, name : bytes, data : int, flags : int, ret : ffi_type, args : list(ffi_type), f : fn_callback) : (world, gobject_repository)
[
	var destr := ffi_destructor_new();
	var zstr := ffi_poke_zstring(destr, name);
	var cb := ffi_callback_create(destr, 0, ret, args);
	var cb_destr := ffi_callback_create(destr, 0, ffi_type.t_void, [ ffi_type.t_pointer, ffi_type.t_pointer ]);
	fn g_signal_connect_data~cache := ffi_function_prototype(gobject_lib, 0, "unsigned long g_signal_connect_data(void *instance, char *detailed_signal, void *c_handler, void *data, void *destroy_data, unsigned connect_flags)");
	xeval ffi_thread_sync_call(repo.thr, destr, g_signal_connect_data, [ gobj.ptr, zstr, cb, data, cb_destr, flags ]);
	ffi_destructor_free(destr, zstr);
	repo.callbacks[cb] := f;
	repo.callbacks[cb_destr] := callback_disconnect(cb, cb_destr,,,);
	repo.destructors[cb] := destr;
	//eval debug("connecting " + ntos_base(cb, 16) + ", " + ntos_base(cb_destr, 16));
]

record gtimer [
	id : int;
	destr : ffi_destructor;
]

fn g_timer_connect(implicit w : world, implicit repo : gobject_repository, priority : int, interval : int, data : int, f : fn_callback) : (world, gobject_repository, gtimer)
[
	var destr := ffi_destructor_new();
	var cb := ffi_callback_create(destr, 0, ffi_type.t_sint, [ ffi_type.t_pointer ]);
	var cb_destr := ffi_callback_create(destr, 0, ffi_type.t_void, [ ffi_type.t_pointer ]);
	fn g_timeout_add_full~cache := ffi_function_prototype(glib_lib, 0, "unsigned g_timeout_add_full(int priority, unsigned interval, void *function, void *data, void *destroy_data)");
	fn g_source_remove~cache := ffi_function_prototype(glib_lib, 0, "int g_source_remove(unsigned tag)");
	var id, e := ffi_thread_sync_call(repo.thr, destr, g_timeout_add_full, [ priority, interval, cb, data, cb_destr ]);
	repo.callbacks[cb] := f;
	repo.callbacks[cb_destr] := callback_disconnect(cb, cb_destr,,,);
	repo.destructors[cb] := destr;
	var destr2 := ffi_destructor_new();
	ffi_thread_destructor_call(destr2, repo.thr, g_source_remove, [ id ]);
	return gtimer.[
		id : id,
		destr : destr2,
	];
]

fn g_idle_connect(implicit w : world, implicit repo : gobject_repository, priority : int, data : int, f : fn_callback) : (world, gobject_repository, gtimer)
[
	var destr := ffi_destructor_new();
	var cb := ffi_callback_create(destr, 0, ffi_type.t_sint, [ ffi_type.t_pointer ]);
	var cb_destr := ffi_callback_create(destr, 0, ffi_type.t_void, [ ffi_type.t_pointer ]);
	fn g_idle_add_full~cache := ffi_function_prototype(glib_lib, 0, "unsigned g_idle_add_full(int priority, void *function, void *data, void *destroy_data)");
	fn g_source_remove~cache := ffi_function_prototype(glib_lib, 0, "int g_source_remove(unsigned tag)");
	var id, e := ffi_thread_sync_call(repo.thr, destr, g_idle_add_full, [ priority, cb, data, cb_destr ]);
	repo.callbacks[cb] := f;
	repo.callbacks[cb_destr] := callback_disconnect(cb, cb_destr,,,);
	repo.destructors[cb] := destr;
	var destr2 := ffi_destructor_new();
	ffi_thread_destructor_call(destr2, repo.thr, g_source_remove, [ id ]);
	return gtimer.[
		id : id,
		destr : destr2,
	];
]

fn g_application_run(implicit w : world, implicit repo : gobject_repository, app : gobject, appname : string, args : list(bytes)) : (world, gobject_repository, int)
[
	args := [ string_to_utf8(appname) ] + args;
	var argv := ffi_destructor_allocate(app.destr, len(args) * ffi_get_size(ffi_type.t_pointer), ffi_get_alignment(ffi_type.t_pointer), false);
	for i := 0 to len(args) do [
		var arg := ffi_poke_zstring(app.destr, args[i]);
		ffi_poke(argv + i * ffi_get_size(ffi_type.t_pointer), ffi_type.t_pointer, arg);
	]
	fn g_application_run~cache := ffi_function_prototype(gio_lib, 0, "int g_application_run(GApplication *application, int argc, char *argv)");
	fn g_application_quit~cache := ffi_function_prototype(gio_lib, 0, "void g_application_quit(GApplication* application)");
	var r, e, u := ffi_thread_callback_call(repo.thr, app.destr, g_application_run, [ app.ptr, len(args), argv ]);
	while any(r, u) do [
		var w_backup := w;
		var repo_backup := repo;
		var cb := ffi_callback_get_address(u);
		//eval debug("callback: " + ntos_base(cb, 16));
		var old_thr := repo.thr;
		repo.thr := ffi_callback_recurse(u);
		var ret : int;
		w, repo, ret := repo.callbacks[cb](w, repo, u);
		if is_exception repo then
			repo := repo_backup;
		repo.thr := old_thr;
		if is_exception w then [
			var rr ee : int;
			w_backup, rr, ee := ffi_thread_sync_call(w_backup, ffi_callback_recurse(u), repo.destr, g_application_quit, [ app.ptr ]);
x:
			w_backup, u := ffi_callback_return(w_backup, u, 0);
			if any(r, u) then [
				xeval repo;
				goto x;
			]
			abort w;
		]
		w, u := ffi_callback_return(w, u, ret);
	]
	xeval app;
	return r;
]
