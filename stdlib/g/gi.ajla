generator g.gi;

uses exception;
uses g.getgi;

fn generate
[
	var dash := list_search_backwards(params, '-');
	if dash = -1 then
		return exception_make(bytes, ec_sync, error_invalid_operation, 0, true);
	var name := params[ .. dash];
	var version := params[dash + 1 .. ];
	return getgi(name, version, false);
]
