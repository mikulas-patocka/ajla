unit opencl;

type cl_world;
type cl_context;

fn cl_mk_world : cl_world;
fn cl_mk_context(implicit w : cl_world) : cl_context;

implementation

uses exception;
uses ffi;

record cl_context [
	destr : ffi_destructor;
]

type cl_world := world;

fn cl_mk_world := unsafe_get_world;

fn opencl_abort(func : bytes, retval : int) : cl_world
[
	abort exception_make_str(cl_world, ec_library, error_invalid_operation, -retval, true, "function " + func + " failed: " + ntos(retval));
]

fn opencl_abort_msg(b : bytes) : cl_world
[
	abort exception_make_str(cl_world, ec_library, error_invalid_operation, 0, true, "OpenCL failed: " + b);
]

fn probe_device(implicit w : cl_world, lib : ffi_library, d : int) : (cl_world, bool)
[
	var ret err : int;
	implicit var destr := ffi_destructor_new();

	var clCreateContext := ffi_create_function(lib, "clCreateContext", ffi_error.e_none, 6, ffi_type.t_pointer, [ ffi_type.t_pointer, ffi_type.t_uint32, ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_pointer ], false);
	var clReleaseContext := ffi_create_function(lib, "clReleaseContext", ffi_error.e_none, 1, ffi_type.t_sint32, [ ffi_type.t_pointer ], false);

	var ptr_devices := ffi_destructor_allocate(ffi_get_size(ffi_type.t_pointer), ffi_get_alignment(ffi_type.t_pointer), false);
	ffi_poke(ptr_devices, ffi_type.t_pointer, d);
	var pk := ffi_peek(ptr_devices, ffi_type.t_pointer);
	var ptr_err_s32 := ffi_destructor_allocate(ffi_get_size(ffi_type.t_sint32), ffi_get_alignment(ffi_type.t_sint32), false);

	atomic_enter();
	ret, err := ffi_call_function(clCreateContext, [ 0, 1, ptr_devices, 0, 0, ptr_err_s32 ]);
	if ret = 0 then [
		atomic_exit();
		return false;
	]
	var ctx := ret;
	ffi_destructor_call(destr, clReleaseContext, [ ctx ]);
	atomic_exit();

	var clCreateProgramWithSource := ffi_create_function(lib, "clCreateProgramWithSource", ffi_error.e_none, 5, ffi_type.t_pointer, [ ffi_type.t_pointer, ffi_type.t_uint32, ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_pointer ], false);
	var clReleaseProgram := ffi_create_function(lib, "clReleaseProgram", ffi_error.e_none, 1, ffi_type.t_sint32, [ ffi_type.t_pointer ], false);

	var code := "__kernel void render(void) { }";

	var ptr_string := ffi_destructor_allocate(len(code), 1, false);
	ffi_poke_array(ptr_string, code);
	var ptr_strings := ffi_destructor_allocate(ffi_get_size(ffi_type.t_pointer), ffi_get_alignment(ffi_type.t_pointer), false);
	ffi_poke(ptr_strings, ffi_type.t_pointer, ptr_string);
	var ptr_sizes := ffi_destructor_allocate(ffi_get_size(ffi_type.t_usize), ffi_get_alignment(ffi_type.t_usize), false);
	ffi_poke(ptr_sizes, ffi_type.t_usize, len(code));

	atomic_enter();
	ret, err := ffi_call_function(clCreateProgramWithSource, [ ctx, 1, ptr_strings, ptr_sizes, ptr_err_s32 ]);
	if ret = 0 then [
		//var e := ffi_peek(ptr_err_s32, ffi_type.t_sint32);
		//eval debug("returned 1: " + ntos(e));
		atomic_exit();
		return false;
	]
	var prog := ret;
	ffi_destructor_call(destr, clReleaseProgram, [ prog ]);
	atomic_exit();
	ffi_destructor_free(ptr_string);
	ffi_destructor_free(ptr_strings);
	ffi_destructor_free(ptr_sizes);

	var clBuildProgram := ffi_create_function(lib, "clBuildProgram", ffi_error.e_none, 6, ffi_type.t_sint32, [ ffi_type.t_pointer, ffi_type.t_uint32, ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_pointer ], false);

	ret, err := ffi_call_function(clBuildProgram, [ prog, 1, ptr_devices, 0, 0, 0 ]);
	if ret <> 0 then [
		//eval debug("returned 2: " + ntos(ret));
		return false;
	]

	ffi_destructor_free(ptr_devices);
	ffi_destructor_free(ptr_err_s32);
	ffi_destructor_destroy();

	return true;
]

fn cl_mk_context(implicit w : cl_world) : cl_context
[
	var ret err : int;
	implicit var destr := ffi_destructor_new();

	var lib := ffi_open_library("OpenCL", true, "");
	xeval lib;

	var clGetPlatformIDs := ffi_create_function(lib, "clGetPlatformIDs", ffi_error.e_none, 3, ffi_type.t_sint32, [ ffi_type.t_uint32, ffi_type.t_pointer, ffi_type.t_pointer ], false);
	var ptr_n_u32 := ffi_destructor_allocate(ffi_get_size(ffi_type.t_uint32), ffi_get_alignment(ffi_type.t_uint32), false);
	ret, err := ffi_call_function(clGetPlatformIDs, [ 0, 0, ptr_n_u32 ]);
	if ret <> 0 then
		abort opencl_abort("clGetPlatformIDs", ret);
	var n_platforms := ffi_peek(ptr_n_u32, ffi_type.t_uint32);
	if n_platforms = 0 then
		abort opencl_abort_msg("No platforms");

	var ptr_platforms := ffi_destructor_allocate(ffi_get_size(ffi_type.t_pointer) * n_platforms, ffi_get_alignment(ffi_type.t_pointer), false);
	ret, err := ffi_call_function(clGetPlatformIDs, [ n_platforms, ptr_platforms, ptr_n_u32 ]);
	if ret <> 0 then
		abort opencl_abort("clGetPlatformIDs", ret);

	var n2 := ffi_peek(ptr_n_u32, ffi_type.t_uint32);
	n_platforms := min(n_platforms, n2);
	if n_platforms = 0 then
		abort opencl_abort_msg("No platforms");
	var platforms := ffi_peek_int_array(ptr_platforms, n_platforms, ffi_type.t_pointer);

	ffi_destructor_free(ptr_platforms);

	eval debug("n_platforms: " + ntos(n_platforms));
	for i := 0 to len(platforms) do
		eval debug("platform: " + ntos_base(platforms[i], 16));

	var device_types := [ 4, 8, 2 ];	// GPU, accelerator, CPU

	var clGetDeviceIDs := ffi_create_function(lib, "clGetDeviceIDs", ffi_error.e_none, 5, ffi_type.t_sint32, [ ffi_type.t_pointer, ffi_type.t_ulong, ffi_type.t_uint, ffi_type.t_pointer, ffi_type.t_pointer ], false);

	var devices := empty(int);

	for dt in device_types do [
		for p := 0 to len(platforms) do [
			ret, err := ffi_call_function(clGetDeviceIDs, [ platforms[p], dt, 0, 0, ptr_n_u32 ]);
			if ret <> 0 then
				continue;
			var n_devices := ffi_peek(ptr_n_u32, ffi_type.t_uint32);
			if n_devices = 0 then
				continue;

			var ptr_devices := ffi_destructor_allocate(ffi_get_size(ffi_type.t_pointer) * n_devices, ffi_get_alignment(ffi_type.t_pointer), false);
			ret, err := ffi_call_function(clGetDeviceIDs, [ platforms[p], dt, n_devices, ptr_devices, ptr_n_u32 ]);
			if ret <> 0 then [
				ffi_destructor_free(ptr_devices);
				continue;
			]

			n2 := ffi_peek(ptr_n_u32, ffi_type.t_uint32);
			n_devices := min(n_devices, n2);
			var devs := ffi_peek_int_array(ptr_devices, n_devices, ffi_type.t_pointer);
			devices += devs;
			ffi_destructor_free(ptr_devices);
		]
	]

	ffi_destructor_free(ptr_n_u32);

	if len(devices) = 0 then
		abort opencl_abort_msg("No devices");

	for i := 0 to len(devices) do [
		eval debug("device: " + ntos_base(devices[i], 16));
	]

	implicit var ctx := cl_context.[ ];

	for i := 0 to len(devices) do [
		var b := probe_device(lib, devices[i]);
		if b then [
			eval debug("valid device: " + ntos_base(devices[i], 16));
			goto found;
		]
	]
	abort opencl_abort_msg("No working devices");

found:
	ffi_destructor_destroy();
	return ctx;
]
