private unit compiler.optimize.offload;

uses compiler.optimize.defs;

fn offload(ctx : context) : context;

implementation

uses compiler.optimize.utils;

fn skip_empty(ctx : context, bgi : int) : int
[
again:
	var block := ctx.blocks[bgi];
	for i := 0 to len(block.instrs) do
		if ctx.instrs[block.instrs[i]].opcode <> P_Line_Info then
			return bgi;
	bgi := block.post_list[0];
	goto again;
]

fn get_phis(ctx : context, bgi : int) : list(instruction)
[
	var block := ctx.blocks[bgi];
	var result := empty(instruction);
	for i := 0 to len(block.instrs) do [
		var instr := ctx.instrs[block.instrs[i]];
		if instr.opcode <> P_Phi then
			break;
		result +<= instr;
	]
	return result;
]

fn last_instr(ctx : context, bgi : int) : instruction
[
	var block := ctx.blocks[bgi];
	if len(block.post_list) <> 3 then
		abort internal("last_instr is not P_Jmp_False");
	return ctx.instrs[block.instrs[len(block.instrs) - 1]];
]

option loop_limit [
	v : int;
	c : int;
	a : int;
]

record array_info [
	typ : int;
	dims : list(int);
	var_phi : int;
	var_in : int;
	var_mod : int;
]

record loop_status [
	control_variable : int;
	added_control_variable : int;
	limit : loop_limit;
	body_bb : int;
	end_bb : int;
	arrays : list(array_info);
]

fn test_loop(ctx : context, start_bgi end_bgi : int) : list(loop_status)
[
	eval debug("test_loop: " + ntos(start_bgi) + ", " + ntos(end_bgi));

	var start_block := ctx.blocks[start_bgi];
	var test_bgi : int;
	if len(start_block.post_list) = 1 then [
		test_bgi := start_block.post_list[0];
	] else if len(start_block.post_list) = 3 then [
		test_bgi := start_bgi;
	] else [
		return empty(loop_status);
	]
	var test_block := ctx.blocks[test_bgi];

	if len(test_block.pred_list) <> 2 then
		return empty(loop_status);
	if len(test_block.post_list) <> 3 then
		return empty(loop_status);
	if skip_empty(ctx, test_block.post_list[1]) <> skip_empty(ctx, end_bgi) then
		return empty(loop_status);

	var skip_instr := last_instr(ctx, test_bgi);
	var bool_var := ctx.variables[skip_instr.params[0]];
	var cmp_instr := ctx.instrs[bool_var.defining_instr];
	if cmp_instr.bb <> test_bgi then
		return empty(loop_status);

	var control_var : int;
	var lim : loop_limit;
	if cmp_instr.opcode = P_BinaryOp then [
		control_var := cmp_instr.params[3];
		lim := loop_limit.v.(cmp_instr.params[5]);
	] else if cmp_instr.opcode = P_BinaryConstOp then [
		control_var := cmp_instr.params[3];
		lim := loop_limit.c.(cmp_instr.params[4]);
	] else if cmp_instr.opcode = P_Array_Len_Greater_Than then [
		control_var := cmp_instr.params[2];
		lim := loop_limit.a.(cmp_instr.params[1]);
	] else [
		return empty(loop_status);
	]

	var test_phis := get_phis(ctx, test_bgi);

	var idx_input : int;
	var var0, var1 := -1, -1;
	for i := 0 to len(test_phis) do [
		if test_phis[i].params[0] = control_var then [
			var0 := test_phis[i].params[1];
			var1 := test_phis[i].params[2];
			var def0 := ctx.instrs[ctx.variables[var0].defining_instr];
			var def1 := ctx.instrs[ctx.variables[var1].defining_instr];
			if def0.opcode = P_Load_Const, len(def0.params) = 2 then [
				idx_input := 1;
			] else if def1.opcode = P_Load_Const, len(def1.params) = 2 then [
				idx_input := 2;
				var0, var1 := var1, var0;
				def0, def1 := def1, def0;
			] else [
				return empty(loop_status);
			]
			test_phis := test_phis[ .. i] + test_phis[i + 1 .. ];
			goto found_control_var;
		]
	]
	return empty(loop_status);
found_control_var:
	var def1 := ctx.instrs[ctx.variables[var1].defining_instr];
	if def1.opcode <> P_BinaryConstOp then
		return empty(loop_status);
	if def1.params[0] <> Bin_Add or
	   def1.params[3] <> control_var or
	   def1.params[4] <> 1 then
		return empty(loop_status);

	var last_bb := def1.bb;
	if len(ctx.blocks[last_bb].post_list) <> 1 then
		return empty(loop_status);
	if ctx.blocks[last_bb].post_list[0] <> test_bgi then
		return empty(loop_status);

	if len(test_phis) = 0 then
		return empty(loop_status);

	var ais := empty(array_info);
	for i := 0 to len(test_phis) do [
		var v := test_phis[i].params[0];
		xeval debug("type_idx: " + ntos(ctx.variables[v].type_index));
		var type_idx := ctx.variables[v].type_index;
		if type_idx < 0 then
			return empty(loop_status);
		var def_instr := ctx.instrs[ctx.variables[type_idx].defining_instr];
		xeval debug("opcode: " + ntos(def_instr.opcode));
		if def_instr.opcode <> P_Array_Fixed then
			return empty(loop_status);
		if def_instr.params[1] > T_SInt8 or def_instr.params[1] < T_Bool then
			return empty(loop_status);
		var ai := array_info.[
			typ : def_instr.params[1],
			dims : empty(int),
			var_phi : v,
			var_in : test_phis[i].params[idx_input],
			var_mod : test_phis[i].params[3 - idx_input],
		];
		var shape_idx := def_instr.params[2];
		var shape_instr := ctx.instrs[ctx.variables[shape_idx].defining_instr];
		if shape_instr.opcode <> P_Array_Create then
			abort internal("shape isn't P_Array_Create");
		var n_dims := shape_instr.params[1];
		if n_dims = 0 then
			return empty(loop_status);
		for j := 0 to n_dims do [
			var dim_var := shape_instr.params[4 + 2 * j];
			ai.dims +<= dim_var;
		]
		ais +<= ai;
	]

	var qq := test_loop(ctx, test_block.post_list[0], last_bb);

	return [ loop_status.[
		control_variable : control_var,
		added_control_variable : var1,
		limit : lim,
		body_bb : test_block.post_list[0],
		end_bb : last_bb,
		arrays : ais,
	] ] + qq;
]

fn offload_instruction(ctx : context, ili : int, ins : instruction) : instruction
[
	var decision_bgi := ins.bb;
	var decision_block := ctx.blocks[decision_bgi];
	var decision_insn := ctx.instrs[decision_block.instrs[len(decision_block.instrs) - 1]];
	if decision_insn.opcode <> P_Jmp_False then [
		eval debug(ctx.name + ": decision block doesn't end with conditional jump");
		goto fail;
	]
	if decision_insn.params[0] <> ins.params[0] then [
		eval debug(ctx.name + ": decision block end doesn't correspond with offload instruction");
		goto fail;
	]
	var loop_bgi := decision_block.post_list[0];
	var end_bgi := decision_block.post_list[1];

	var shape := test_loop(ctx, loop_bgi, end_bgi);
	if len(shape) = 0 then [
		eval debug(ctx.name + ": loop doesn't have appropriate shape");
		goto fail;
	]
	if len(shape) > 3 then [
		eval debug(ctx.name + ": more than 3 dimensions");
		goto fail;
	]
	eval debug("loop recognized, dim: " + ntos(len(shape)));

	var in_arrays := shape[0].arrays;
	for j := 0 to len(in_arrays) do [
		var arr := in_arrays[j];
		var vi := arr.var_in;
		var def_instr := ctx.instrs[ctx.variables[vi].defining_instr];
		if def_instr.opcode <> P_Array_Fill then [
			eval debug(ctx.name + ": array not created immediatelly before the loop");
			goto fail;
		]
	]
	for i := 1 to len(shape) do [
		var prev_sh := shape[i - 1];
		var sh := shape[i];
		if len(sh.arrays) <> len(in_arrays) then [
			eval debug(ctx.name + ": array inconsistency");
			goto fail;
		]
		var sorted_arrays := empty(array_info);
		for j := 0 to len(in_arrays) do [
			var a1 := prev_sh.arrays[j];
			for k := 0 to len(in_arrays) do [
				var a2 := sh.arrays[k];
				if a1.var_phi = a2.var_in, a1.var_mod = a2.var_phi then [
					sorted_arrays +<= a2;
					goto found_array;
				]
			]
			eval debug(ctx.name + ": array inconsistency");
			goto fail;
found_array:
		]
		shape[i].arrays := sorted_arrays;
	]

	var sh := shape[len(shape) - 1];
	var sh_arrays := sh.arrays;
	for j := 0 to len(sh_arrays) do [
		var a := sh_arrays[j];
		var var_mod := a.var_mod;
		//eval debug("a(" + ntos(j) + "): var_mod: " + ntos(a.var_mod) + ", var_in: " + ntos(a.var_in) + ", var_phi: " + ntos(a.var_phi));
		var def_var_mod := ctx.instrs[ctx.variables[var_mod].defining_instr];
		if def_var_mod.opcode <> P_Structured_Write then [
			eval debug(ctx.name + ": array must be modified unconditionally");
			goto fail;
		]
		if def_var_mod.params[3] <> a.var_phi then [
			eval debug(ctx.name + ": array must be modified just once");
			goto fail;
		]
		if def_var_mod.params[0] <> 1 then [
			eval debug(ctx.name + ": array must be fully modified");
			goto fail;
		]
		var shape_idxs := empty(int);
		var var_idx := def_var_mod.params[7];
		var used_shapes := 0;
		for k := 1 to len(shape) do [
			var def_var_idx := ctx.instrs[ctx.variables[var_idx].defining_instr];
			if def_var_idx.opcode <> P_BinaryOp or def_var_idx.params[0] <> Bin_Add then [
				eval debug(ctx.name + ": invalid array indices");
				goto fail;
			]
			var op1 := def_var_idx.params[3];
			var op2 := def_var_idx.params[5];
			var ll : int;
			for l := 0 to len(shape) do [
				if shape[l].control_variable = op1 then [
					ll := l;
					goto found_cv;
				]
				if shape[l].control_variable = op2 then [
					op1, op2 := op2, op1;
					ll := l;
					goto found_cv;
				]
			]
			eval debug(ctx.name + ": invalid array indices");
			goto fail;
found_cv:
			if used_shapes bt ll then [
				eval debug(ctx.name + ": invalid array indices");
				goto fail;
			]
			used_shapes bts= ll;
			shape_idxs +<= ll;
			var def_var_mult := ctx.instrs[ctx.variables[op2].defining_instr];
			if def_var_mult.opcode = P_BinaryOp, def_var_mult.params[0] = Bin_Multiply then [
				var m1 := def_var_mult.params[3];
				var m2 := def_var_mult.params[5];
				for l := 0 to len(shape) do [
					if shape[l].control_variable = m1 then [
						goto found_x;
					]
					if shape[l].control_variable = m2 then [
						m1, m2 := m2, m1;
						goto found_x;
					]
				]
				eval debug(ctx.name + ": invalid array indices");
				goto fail;
found_x:
				var_idx := m1;
				if shape[ll].limit is v, shape[ll].limit.v = m2 then
					goto mult_ok;
				if shape[ll].limit is a then [
					var def_var_m2 := ctx.instrs[ctx.variables[m2].defining_instr];
					if def_var_m2.opcode = P_Array_Len, def_var_m2.params[1] = shape[ll].limit.a then
						goto mult_ok;
				]
			] else if def_var_mult.opcode = P_BinaryConstOp, def_var_mult.params[0] = Bin_Multiply then [
				var_idx := def_var_mult.params[3];
				if shape[ll].limit is c, shape[ll].limit.c = def_var_mult.params[4] then
					goto mult_ok;
			]
			eval debug(ctx.name + ": invalid array indices");
			goto fail;
mult_ok:
		]
		var ll : int;
		for l := 0 to len(shape) do [
			if shape[l].control_variable = var_idx then [
				ll := l;
				goto found_cv2;
			]
		]
		eval debug(ctx.name + ": invalid array indices");
		goto fail;
found_cv2:
		if used_shapes bt ll then [
			eval debug(ctx.name + ": invalid array indices");
			goto fail;
		]
		shape_idxs +<= ll;

		for k := 0 to len(shape_idxs) do [
			var shape_limit := shape[shape_idxs[k]].limit;
			var a_def := ctx.instrs[ctx.variables[a.dims[k]].defining_instr];
			if shape_limit is v then [
				if a.dims[k] = shape_limit.v then
					continue;
			] else if shape_limit is c then [
				if a_def.opcode = P_Load_Const, a_def.params[1] = 1, a_def.params[2] = shape_limit.c then
					continue;
			] else if shape_limit is a then [
				if a_def.opcode = P_Array_Len, a_def.params[1] = shape_limit.a then
					continue;
			]
			eval debug(ctx.name + ": invalid array size");
			goto fail;
		]
	]

	eval debug("arrays verified");

fail:
	return ins;
]

fn offload(ctx : context) : context
[
	//eval dump_basic_blocks(ctx, true);
	var n_blocks := len(ctx.blocks);
	for bgi := 0 to n_blocks do [
		var block := ctx.blocks[bgi];
		if not block.active then
			continue;
		var l := len(block.instrs);
		for ili := 0 to l do [
			var igi := ctx.blocks[bgi].instrs[ili];
			var ins := ctx.instrs[igi];
			if ins.opcode = P_Offload then [
				ins := offload_instruction(ctx, ili, ins);
				ctx.instrs[igi] := ins;
			]
		]
	]
	return ctx;
]
