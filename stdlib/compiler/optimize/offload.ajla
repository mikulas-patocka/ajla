private unit compiler.optimize.offload;

uses compiler.optimize.defs;

fn offload(ctx : context) : context;

implementation

uses charset;
uses compiler.optimize.utils;

fn skip_empty(ctx : context, bgi : int) : int
[
again:
	var block := ctx.blocks[bgi];
	for i := 0 to len(block.instrs) do
		if ctx.instrs[block.instrs[i]].opcode <> P_Line_Info then
			return bgi;
	bgi := block.post_list[0];
	goto again;
]

fn get_phis(ctx : context, bgi : int) : list(instruction)
[
	var block := ctx.blocks[bgi];
	var result := empty(instruction);
	for i := 0 to len(block.instrs) do [
		var instr := ctx.instrs[block.instrs[i]];
		if instr.opcode <> P_Phi then
			break;
		result +<= instr;
	]
	return result;
]

fn last_instr(ctx : context, bgi : int) : instruction
[
	var block := ctx.blocks[bgi];
	if len(block.post_list) <> 3 then
		abort internal("last_instr is not P_Jmp_False");
	return ctx.instrs[block.instrs[len(block.instrs) - 1]];
]

option loop_limit [
	v : int;
	c : int;
	a : int;
]

record array_info [
	typ : int;
	dims : list(int);
	var_phi : int;
	var_in : int;
	var_mod : int;
]

record loop_status [
	control_variable : int;
	added_control_variable : int;
	limit : loop_limit;
	body_bb : int;
	end_bb : int;
	arrays : list(array_info);
]

fn test_loop(ctx : context, start_bgi end_bgi : int) : (list(loop_status), bytes)
[
	//eval debug("test_loop: " + ntos(start_bgi) + ", " + ntos(end_bgi));

	var start_block := ctx.blocks[start_bgi];
	var test_bgi : int;
	if len(start_block.post_list) = 1 then [
		test_bgi := start_block.post_list[0];
	] else if len(start_block.post_list) = 3 then [
		test_bgi := start_bgi;
	] else [
		return empty(loop_status), "invalid post_list";
	]
	var test_block := ctx.blocks[test_bgi];

	if len(test_block.pred_list) <> 2 then
		return empty(loop_status), "invalid pred_list";
	if len(test_block.post_list) <> 3 then
		return empty(loop_status), "invalid post_list";
	if skip_empty(ctx, test_block.post_list[1]) <> skip_empty(ctx, end_bgi) then
		return empty(loop_status), "post_list doesn't match end_bgi";

	var skip_instr := last_instr(ctx, test_bgi);
	var bool_var := ctx.variables[skip_instr.params[0]];
	var cmp_instr := ctx.instrs[bool_var.defining_instr];
	if cmp_instr.bb <> test_bgi then
		return empty(loop_status), "cmp instruction isn't in test_bgi";

	var control_var : int;
	var lim : loop_limit;
	if cmp_instr.opcode = P_BinaryOp, cmp_instr.params[0] = Bin_Less then [
		control_var := cmp_instr.params[3];
		lim := loop_limit.v.(cmp_instr.params[5]);
	] else if cmp_instr.opcode = P_BinaryConstOp, cmp_instr.params[0] = Bin_Less then [
		control_var := cmp_instr.params[3];
		lim := loop_limit.c.(cmp_instr.params[4]);
	] else if cmp_instr.opcode = P_Array_Len_Greater_Than then [
		control_var := cmp_instr.params[2];
		lim := loop_limit.a.(cmp_instr.params[1]);
	] else [
		return empty(loop_status), "unsupported loop condition";
	]

	var test_phis := get_phis(ctx, test_bgi);

	var idx_input : int;
	var var0, var1 := -1, -1;
	for i := 0 to len(test_phis) do [
		if test_phis[i].params[0] = control_var then [
			var0 := test_phis[i].params[1];
			var1 := test_phis[i].params[2];
			var def0 := ctx.instrs[ctx.variables[var0].defining_instr];
			var def1 := ctx.instrs[ctx.variables[var1].defining_instr];
			if def0.opcode = P_Load_Const, len(def0.params) = 2 then [
				idx_input := 1;
			] else if def1.opcode = P_Load_Const, len(def1.params) = 2 then [
				idx_input := 2;
				var0, var1 := var1, var0;
				def0, def1 := def1, def0;
			] else [
				return empty(loop_status), "unsupported loop start";
			]
			test_phis := test_phis[ .. i] + test_phis[i + 1 .. ];
			goto found_control_var;
		]
	]
	return empty(loop_status), "unsupported loop start";
found_control_var:
	var def1 := ctx.instrs[ctx.variables[var1].defining_instr];
	if def1.opcode <> P_BinaryConstOp then
		return empty(loop_status), "unsupported loop increment";
	if def1.params[0] <> Bin_Add or
	   def1.params[3] <> control_var or
	   def1.params[4] <> 1 then
		return empty(loop_status), "unsupported loop increment";

	var last_bb := def1.bb;
	if len(ctx.blocks[last_bb].post_list) <> 1 then
		return empty(loop_status), "loop exits to multiple basic blocks";
	if ctx.blocks[last_bb].post_list[0] <> test_bgi then
		return empty(loop_status), "loop exits to a different basic block";

	if len(test_phis) = 0 then
		return empty(loop_status), "loop doesn't have any modified variables";

	var ais := empty(array_info);
	for i := 0 to len(test_phis) do [
		var v := test_phis[i].params[0];
		//xeval debug("type_idx: " + ntos(ctx.variables[v].type_index));
		var type_idx := ctx.variables[v].type_index;
		if type_idx < 0 then
			return empty(loop_status), "type of modified variable is not array";
		var def_instr := ctx.instrs[ctx.variables[type_idx].defining_instr];
		//xeval debug("opcode: " + ntos(def_instr.opcode));
		if def_instr.opcode <> P_Array_Fixed then
			return empty(loop_status), "type of modified variable is not array";
		if def_instr.params[1] > T_SInt8 or def_instr.params[1] < T_Bool then
			return empty(loop_status), "type of modified variable is not array of primitive type";
		var ai := array_info.[
			typ : def_instr.params[1],
			dims : empty(int),
			var_phi : v,
			var_in : test_phis[i].params[idx_input],
			var_mod : test_phis[i].params[3 - idx_input],
		];
		var shape_idx := def_instr.params[2];
		var shape_instr := ctx.instrs[ctx.variables[shape_idx].defining_instr];
		if shape_instr.opcode <> P_Array_Create then
			abort internal("shape isn't P_Array_Create");
		var n_dims := shape_instr.params[1];
		if n_dims = 0 then
			return empty(loop_status), "array has zero dimensions";
		for j := 0 to n_dims do [
			var dim_var := shape_instr.params[4 + 2 * j];
			ai.dims +<= dim_var;
		]
		ais +<= ai;
	]

	var qq, err := test_loop(ctx, test_block.post_list[0], last_bb);

	return [ loop_status.[
		control_variable : control_var,
		added_control_variable : var1,
		limit : lim,
		body_bb : test_block.post_list[0],
		end_bb : last_bb,
		arrays : ais,
	] ] + qq, "";
]

fn verify_arrays(ctx : context, shape : list(loop_status)) : bytes
[
	var in_arrays := shape[0].arrays;
	for j := 0 to len(in_arrays) do [
		var arr := in_arrays[j];
		var vi := arr.var_in;
		var def_instr := ctx.instrs[ctx.variables[vi].defining_instr];
		if def_instr.opcode <> P_Array_Fill then
			return "array not created immediatelly before the loop";
	]
	for i := 1 to len(shape) do [
		var prev_sh := shape[i - 1];
		var sh := shape[i];
		if len(sh.arrays) <> len(in_arrays) then
			return "array inconsistency";
		var sorted_arrays := empty(array_info);
		for j := 0 to len(in_arrays) do [
			var a1 := prev_sh.arrays[j];
			for k := 0 to len(in_arrays) do [
				var a2 := sh.arrays[k];
				if a1.var_phi = a2.var_in, a1.var_mod = a2.var_phi then [
					sorted_arrays +<= a2;
					goto found_array;
				]
			]
			return "array inconsistency";
found_array:
		]
		shape[i].arrays := sorted_arrays;
	]

	var sh := shape[len(shape) - 1];
	var sh_arrays := sh.arrays;
	for j := 0 to len(sh_arrays) do [
		var a := sh_arrays[j];
		var var_mod := a.var_mod;
		//eval debug("a(" + ntos(j) + "): var_mod: " + ntos(a.var_mod) + ", var_in: " + ntos(a.var_in) + ", var_phi: " + ntos(a.var_phi));
		var def_var_mod := ctx.instrs[ctx.variables[var_mod].defining_instr];
		if def_var_mod.opcode <> P_Structured_Write then
			return "array must be modified unconditionally";
		if def_var_mod.params[3] <> a.var_phi then
			return "array must be modified just once";
		if def_var_mod.params[0] <> 1 then
			return "array must be fully modified";
		var shape_idxs := empty(int);
		var var_idx := def_var_mod.params[7];
		var used_shapes := 0;
		for k := 1 to len(shape) do [
			var def_var_idx := ctx.instrs[ctx.variables[var_idx].defining_instr];
			if def_var_idx.opcode <> P_BinaryOp or def_var_idx.params[0] <> Bin_Add then
				return "invalid array indices";
			var op1 := def_var_idx.params[3];
			var op2 := def_var_idx.params[5];
			var ll : int;
			for l := 0 to len(shape) do [
				if shape[l].control_variable = op1 then [
					ll := l;
					goto found_cv;
				]
				if shape[l].control_variable = op2 then [
					op1, op2 := op2, op1;
					ll := l;
					goto found_cv;
				]
			]
			return "invalid array indices";
found_cv:
			if used_shapes bt ll then
				return "invalid array indices";
			used_shapes bts= ll;
			shape_idxs +<= ll;
			var def_var_mult := ctx.instrs[ctx.variables[op2].defining_instr];
			if def_var_mult.opcode = P_BinaryOp, def_var_mult.params[0] = Bin_Multiply then [
				var m1 := def_var_mult.params[3];
				var m2 := def_var_mult.params[5];
				for l := 0 to len(shape) do [
					if shape[l].control_variable = m1 then [
						goto found_x;
					]
					if shape[l].control_variable = m2 then [
						m1, m2 := m2, m1;
						goto found_x;
					]
				]
				return "invalid array indices";
found_x:
				var_idx := m1;
				if shape[ll].limit is v, shape[ll].limit.v = m2 then
					goto mult_ok;
				if shape[ll].limit is a then [
					var def_var_m2 := ctx.instrs[ctx.variables[m2].defining_instr];
					if def_var_m2.opcode = P_Array_Len, def_var_m2.params[1] = shape[ll].limit.a then
						goto mult_ok;
				]
			] else if def_var_mult.opcode = P_BinaryConstOp, def_var_mult.params[0] = Bin_Multiply then [
				var_idx := def_var_mult.params[3];
				if shape[ll].limit is c, shape[ll].limit.c = def_var_mult.params[4] then
					goto mult_ok;
			]
			return "invalid array indices";
mult_ok:
		]
		var ll : int;
		for l := 0 to len(shape) do [
			if shape[l].control_variable = var_idx then [
				ll := l;
				goto found_cv2;
			]
		]
		return "invalid array indices";
found_cv2:
		if used_shapes bt ll then
			return "invalid array indices";
		shape_idxs +<= ll;

		for k := 0 to len(shape_idxs) do [
			var shape_limit := shape[shape_idxs[k]].limit;
			var a_def := ctx.instrs[ctx.variables[a.dims[k]].defining_instr];
			if shape_limit is v then [
				if a.dims[k] = shape_limit.v then
					continue;
			] else if shape_limit is c then [
				if a_def.opcode = P_Load_Const, a_def.params[1] = 1, a_def.params[2] = shape_limit.c then
					continue;
			] else if shape_limit is a then [
				if a_def.opcode = P_Array_Len, a_def.params[1] = shape_limit.a then
					continue;
			]
			return "invalid array size";
		]
	]

	return "";
]

fn num2str(v : int) := bytes_locase(ntos_base(v, 16));

option ocl_type [
	fixed;
	integer;
	fp;
	boolean;
	invalid;
]

fn get_type(ctx : context, t : int) : (bytes, ocl_type, int)
[
	var ot : ocl_type;
	if t <= T_SInt8, t >= T_UInt128 then
		ot := ocl_type.fixed;
	else if t <= T_Integer, t >= T_Integer128 then
		ot := ocl_type.integer;
	else if t <= T_Real16, t >= T_Real128 then
		ot := ocl_type.fp;
	else if t = T_Bool then
		ot := ocl_type.boolean;
	else if t >= 0 then
		goto arr;
	else
		return "", ocl_type.invalid, 0;
	var integer := t <= T_Integer and t >= T_Integer128;
	var fp := t <= T_Real16 and t >= T_Real128;
	if t = T_Integer then [
		var s := sysprop(SystemProperty_Int_Size);
		if s = 1 then t := T_Integer8;
		else if s = 2 then t := T_Integer16;
		else if s = 4 then t := T_Integer32;
		else if s = 8 then t := T_Integer64;
		else abort internal("unknown integer size: " + ntos(s));
	]
	if t = T_Bool then [
		var s := sysprop(SystemProperty_Bool_Size);
		if s = 1 then t := T_UInt8;
		else if s = 2 then t := T_UInt16;
		else if s = 4 then t := T_UInt32;
		else if s = 8 then t := T_UInt64;
		else abort internal("unknown bool size: " + ntos(s));
	]
	if t = T_SInt8 then return "char", ot, 8;
	if t = T_UInt8 then return "uchar", ot, 8;
	if t = T_SInt16 then return "short", ot, 16;
	if t = T_UInt16 then return "ushort", ot, 16;
	if t = T_SInt32 then return "int", ot, 32;
	if t = T_UInt32 then return "uint", ot, 32;
	if t = T_SInt64 then return "long", ot, 64;
	if t = T_UInt64 then return "ulong", ot, 64;
	if t = T_Integer8 then return "char", ot, 8;
	if t = T_Integer16 then return "short", ot, 16;
	if t = T_Integer32 then return "int", ot, 32;
	if t = T_Integer64 then return "long", ot, 64;
	if t = T_Real16 then return "half", ot, 2;
	if t = T_Real32 then return "float", ot, 4;
	if t = T_Real64 then return "double", ot, 8;
	return "", ot, 0;
arr:
	var def_instr := ctx.instrs[ctx.variables[t].defining_instr];
	if def_instr.opcode <> P_Array_Flexible and def_instr.opcode <> P_Array_Fixed then
		return "", ocl_type.invalid, 0;
	if def_instr.params[1] > T_SInt8 or def_instr.params[1] < T_Bool then
		return "", ocl_type.invalid, 0;

	var str : bytes;
	var bits : int;
	str, ot, bits := get_type(ctx, def_instr.params[1]);

	return str+" *", ot, bits;
]

fn get_variable_type(ctx : context, v : int) : (bytes, ocl_type, int)
[
	return get_type(ctx, ctx.variables[v].type_index);
]

fn get_integer_type(ctx : context)
[
	var t, ot, bits := get_type(ctx, T_Integer);
	return t;
]

fn process_structured_write(ctx : context, ins : instruction) : (context, bytes)
[
	if ins.params[0] <> 1 or ins.params[6] <> Structured_Array then [
		eval debug(ctx.name + ": invalid structured write");
		return ctx, "";
	]
	var output := "	"+ctx.variables[ins.params[1]].offload_name+"["+ctx.variables[ins.params[7]].offload_name+"] = "+ctx.variables[ins.params[5]].offload_name+";"+nl;
	return ctx, output;
]

fn process_binary_operator(ctx : context, ins : instruction) : (context, bytes)
[
	var cnst := ins.opcode = P_BinaryConstOp;
	var unary := ins.opcode = P_UnaryOp;
	var t, ot, bits := get_variable_type(ctx, ins.params[1]);
	var op := ins.params[0];
	var op1_name op2_name : bytes;
	op1_name := ctx.variables[ins.params[3]].offload_name;
	if unary then
		op2_name := "";
	else if not cnst then
		op2_name := ctx.variables[ins.params[5]].offload_name;
	else
		op2_name := "("+t+")"+ntos(ins.params[4]);
	var output := "	{"+nl;
	if op = Un_ConvertToInt then [
		var ti := get_integer_type(ctx);
		output += "		"+ti+" result;"+nl;
	] else [
		output += "		"+t+" result;"+nl;
	]
	if op = Bin_Add then [
		output += "		result = "+op1_name+" + "+op2_name+";"+nl;
		if ot is integer then [
			output += "		if ((~("+op1_name+" ^ "+op2_name+") & ("+op2_name+" ^ result)) < 0)"+nl;
			output += "			goto exception;"+nl;
		]
	] else if op = Bin_Subtract then [
		output += "		result = "+op1_name+" - "+op2_name+";"+nl;
		if ot is integer then [
			output += "		if ((~("+op2_name+" ^ result) & ("+op1_name+" ^ result)) < 0)"+nl;
			output += "			goto exception;"+nl;
		]
	] else if op = Bin_Multiply then [
		output += "		result = "+op1_name+" * "+op2_name+";"+nl;
		if ot is integer then [
			output += "		if ((result >> "+ntos(bits-1)+") != mul_hi("+op1_name+", "+op2_name+"))"+nl;
			output += "			goto exception;"+nl;
		]
	] else if op = Bin_Divide_Int then [
		output += "		if ("+op2_name+" == 0)"+nl;
		if ot is integer then
			output += "			goto exception;"+nl;
		else
			output += "			result = 0;"+nl;
		if t[0] <> 'u' then [
			output += "		else if ("+op2_name+" == -1 && "+op1_name+" == ("+t+")1 << "+ntos(bits-1)+")"+nl;
			if ot is integer then
				output += "			goto exception;"+nl;
			else
				output += "			result = ("+t+")1 << "+ntos(bits-1)+";"+nl;
		]
		output += "		else"+nl;
		output += "			result = "+op1_name+" / "+op2_name+";"+nl;
	] else if op = Un_ConvertToInt or op = Un_ConvertFromInt then [
		output += "		result = "+op1_name+";"+nl;
		output += "		if (result != "+op1_name+")"+nl;
		output += "			goto exception;"+nl;
	] else [
		eval debug(ctx.name + ": unsupported operator " + ntos(op));
		return ctx, "";
	]
	output += "		"+ctx.variables[ins.params[1]].offload_name+" = result;"+nl;
	output += "	}"+nl;
	return ctx, output;
]

fn process_array_load(ctx : context, ins : instruction) : (context, bytes)
[
	var output := "	{"+nl;
	var rv := ins.params[0];
	var av := ins.params[2];
	var iv := ins.params[3];
	if not ctx.imported_variables bt av then [
		eval debug(ctx.name + ": unsupported array");
		return ctx, "";
	]
	var rname := ctx.variables[rv].offload_name;
	var aname := ctx.variables[av].offload_name;
	var iname := ctx.variables[iv].offload_name;
	var ti := get_integer_type(ctx);
	if (ins.params[1] and Flag_Index_In_Range) = 0 then [
		output += "		if ((u"+ti+")"+iname+" >= (u"+ti+")"+aname+"_len)"+nl;
		output += "			goto exception;"+nl;
	]
	output += "		"+rname+" = "+aname+"["+iname+"];" + nl;
	output += "	}"+nl;
	return ctx, output;
]

fn process_basic_block(ctx : context, bgi : int, last : bool) : (context, bytes)
[
	var output := "";
	var bb := ctx.blocks[bgi];
	output += bb.block_name+":"+nl;
	for ili := 0 to len(bb.instrs) do [
		var s : bytes;
		var ins := ctx.instrs[bb.instrs[ili]];
		var ws := ins.write_set;
		if popcnt ws <> 1 then
			continue;
		var wr := ins.params[bsf ws];
		if ins.opcode = P_Structured_Write and ctx.output_array_variables bt wr then [
			ctx, s := process_structured_write(ctx, ins);
			if not len_greater_than(s, 0) then
				return ctx, "";
			output += s;
			continue;
		]
		if not ctx.local_variables bt wr then
			continue;
		if ins.opcode = P_BinaryOp or ins.opcode = P_BinaryConstOp or ins.opcode = P_UnaryOp then [
			ctx, s := process_binary_operator(ctx, ins);
			if not len_greater_than(s, 0) then
				return ctx, "";
			output += s;
			continue;
		]
		if ins.opcode = P_Array_Load then [
			ctx, s := process_array_load(ctx, ins);
			if not len_greater_than(s, 0) then
				return ctx, "";
			output += s;
			continue;
		]
		eval debug(ctx.name + ": unsupported opcode " + ntos(ins.opcode));
		return ctx, "";
	]
	if last then
		output += "	return;"+nl;
	return ctx, output;
]

fn offload_instruction(ctx : context, ili : int, ins : instruction) : instruction
[
	var decision_bgi := ins.bb;
	var decision_block := ctx.blocks[decision_bgi];
	var decision_insn := ctx.instrs[decision_block.instrs[len(decision_block.instrs) - 1]];
	if decision_insn.opcode <> P_Jmp_False then [
		eval debug(ctx.name + ": decision block doesn't end with conditional jump");
		goto fail;
	]
	if decision_insn.params[0] <> ins.params[0] then [
		eval debug(ctx.name + ": decision block end doesn't correspond with offload instruction");
		goto fail;
	]
	var loop_bgi := decision_block.post_list[0];
	var end_bgi := decision_block.post_list[1];

	var shape, err := test_loop(ctx, loop_bgi, end_bgi);
	if len(shape) = 0 then [
		eval debug(ctx.name + ": " + err);
		goto fail;
	]
	//eval debug("loop recognized, dim: " + ntos(len(shape)));
	if len(shape) > 3 then
		shape := shape[ .. 3];

	err := verify_arrays(ctx, shape);
	if len_greater_than(err, 0) then [
		eval debug(ctx.name + ": " + err);
		goto fail;
	]

	var inner_shape := shape[len(shape) - 1];

	//eval debug("arrays verified: " + ntos(inner_shape.body_bb) + " - " + ntos(inner_shape.end_bb));

	var bbs := cast(node_set, 0) bts inner_shape.body_bb;
	var worklist := bbs;
	ctx.blocks[inner_shape.body_bb].block_name := "bb_"+num2str(inner_shape.body_bb);
	while worklist <> 0 do [
		var b : int := bsr worklist;
		worklist btr= b;
		if b = inner_shape.end_bb then
			continue;
		var bb := ctx.blocks[b];
		for i := 0 to len(bb.post_list) do [
			var p := bb.post_list[i];
			if bbs bt p then
				continue;
			if not ctx.blocks[inner_shape.body_bb].dominates bt p then
				continue;
			bbs bts= p;
			ctx.blocks[p].block_name := "bb_"+num2str(p);
			worklist bts= p;
		]
	]

	var imported_variables : var_set := 0;
	var local_variables : var_set := 0;
	var output_array_variables : var_set := 0;
	var loop_controls : var_set := 0;
	var var_worklist : var_set := 0;
	for i := 0 to len(inner_shape.arrays) do [
		var_worklist bts= inner_shape.arrays[i].var_mod;
		output_array_variables bts= inner_shape.arrays[i].var_mod;
		output_array_variables bts= inner_shape.arrays[i].var_phi;
		ctx.variables[inner_shape.arrays[i].var_mod].offload_name := "out_"+ntos(i);
	]
	for i := 0 to len(shape) do [
		var cv := shape[i].control_variable;
		loop_controls bts= cv;
		var t, ot, bits := get_variable_type(ctx, cv);
		if not len_greater_than(t, 0) then [
			eval debug(ctx.name + ": loop control variable has unsupported type");
			goto fail;
		]
		ctx.variables[cv].offload_name := "("+t+")get_global_id("+ntos(i)+")";
		//eval debug("control variable " + ctx.variables[cv].offload_name);
	]
	while var_worklist <> 0 do [
		var v : int := bsr var_worklist;
		var_worklist btr= v;
		var def_instr := ctx.instrs[ctx.variables[v].defining_instr];
		if not bbs bt def_instr.bb then [
			imported_variables bts= v;
			ctx.variables[v].offload_name := "arg_"+num2str(v);
			//eval debug("imported variable: " + ntos(v) + ", " + ctx.variables[v].name);
			continue;
		]
		if def_instr.opcode = P_Call or def_instr.opcode = P_Call_Indirect then [
			eval debug(ctx.name + ": uninlined call instruction");
			goto fail;
		]
		if popcnt def_instr.write_set <> 1 then [
			eval debug(ctx.name + ": unsupported instruction");
			goto fail;
		]
		if not output_array_variables bt v then [
			local_variables bts= v;
			ctx.variables[v].offload_name := "var_"+num2str(v);
			//eval debug("local variable: " + ntos(v) + ", " + ctx.variables[v].name);
		]
		var s := def_instr.read_set;
		while s <> 0 do [
			var q : int := bsr s;
			s btr= q;
			var vv := def_instr.params[q];
			if (imported_variables or local_variables or output_array_variables or loop_controls) bt vv then
				continue;
			var_worklist bts= vv;
		]
	]
	ctx.imported_variables := imported_variables;
	ctx.local_variables := local_variables;
	ctx.output_array_variables := output_array_variables;
	ctx.loop_controls := loop_controls;

	var output := "__kernel void offload(__write_only __global char * err";
	for i := 0 to len(inner_shape.arrays) do [
		var t, ot, bits := get_variable_type(ctx, inner_shape.arrays[i].var_mod);
		output += ", __write_only __global "+t+" "+ctx.variables[inner_shape.arrays[i].var_mod].offload_name;
	]
	var_worklist := imported_variables;
	while var_worklist <> 0 do [
		var v : int := bsf var_worklist;
		var_worklist btr= v;
		var t, ot, bits := get_variable_type(ctx, v);
		if not len_greater_than(t, 0) then [
			eval debug(ctx.name + ": imported variable has unsupported type");
			goto fail;
		]
		if t[len(t) - 1] = '*' then [
			output += ", __constant "+t+" "+ctx.variables[v].offload_name;
			output += ", u"+get_integer_type(ctx)+" "+ctx.variables[v].offload_name+"_len";
		] else [
			output += ", "+t+" "+ctx.variables[v].offload_name;
		]
	]
	output += ")"+nl;
	output += "{"+nl;

	var_worklist := local_variables;
	while var_worklist <> 0 do [
		var v : int := bsf var_worklist;
		var_worklist btr= v;
		var t, ot, bits := get_variable_type(ctx, v);
		if not len_greater_than(t, 0) then [
			eval debug(ctx.name + ": local variable has unsupported type");
			goto fail;
		]
		output += "	"+t+" "+ctx.variables[v].offload_name+";"+nl;
	]

	output += "	goto "+ctx.blocks[inner_shape.body_bb].block_name+";"+nl;

	worklist := bbs;
	while worklist <> 0 do [
		var b : int := bsf worklist;
		worklist btr= b;
		var s : bytes;
		ctx, s := process_basic_block(ctx, b, b = inner_shape.end_bb);
		if not len_greater_than(s, 0) then
			goto fail;
		output += s;
	]

	output += "exception:"+nl;
	output += "	*err = 1;"+nl;
	output += "	return;"+nl;
	output += "}";

	xeval debug(output);

fail:
	return ins;
]

fn offload(ctx : context) : context
[
	var n_blocks := len(ctx.blocks);
	for bgi := 0 to n_blocks do [
		var block := ctx.blocks[bgi];
		if not block.active then
			continue;
		var l := len(block.instrs);
		for ili := 0 to l do [
			var igi := ctx.blocks[bgi].instrs[ili];
			var ins := ctx.instrs[igi];
			if ins.opcode = P_Offload then [
				ins := offload_instruction(ctx, ili, ins);
				ctx.instrs[igi] := ins;
				//eval dump_basic_blocks(ctx, true);
			]
		]
	]
	return ctx;
]
