unit compiler.parser.unit;

uses io;
uses compiler.parser.dict;

private fn compile_module_2(w : world, d : list(bytes), file : bytes, fid_flags : uint8, prereq len_greater_than(d, 0)) : (list(list(pcode_t)), list(module_unique_id));

implementation

uses compiler.parser.parser;
uses compiler.parser.export;

fn compile_module_2(w : world, d : list(bytes), file : bytes, fid_flags : uint8, prereq len_greater_than(d, 0)) : (list(list(pcode_t)), list(module_unique_id))
[
	{var tm : int64;
	w, tm := get_monotonic_time(w);
	eval debug("compile_module_2: " + file + ", " + ntos(tm));}

	var dict := parse_file(w, d, file, fid_flags, false);

	var m := empty(module_unique_id);
	for i := 0 to len(dict.modules) do [
		m +<= dict.modules[i].id;
	]

	{w, tm := get_monotonic_time(w);
	eval debug("compile_module_2 gp: " + file + ", " + ntos(tm));}

	var pcl, modules := generate_pcode(dict), m;

	{w, tm := get_monotonic_time(w);
	eval debug("compile_module_2 done: " + file + ", " + ntos(tm));}

	return pcl, modules;
]
