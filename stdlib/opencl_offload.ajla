private unit opencl_offload;

uses ffi;

record offload_request [
	function_name : bytes;
	shape : list(int);
	args : list(int);
	arg_types : list(ffi_type);
	arg_lengths : list(int);
	arg_n_entries : list(int);
	results_in : list(bytes);
	results_out : list(int);
	results_lengths : list(int);
	kernel : bytes;
]

fn do_offload(rq : offload_request) : bool;

implementation

uses opencl;

fn do_offload(rq : offload_request) : bool
[
	if is_exception rq then [
		eval warning("failed to generate offload request: " + exception_string rq);
		return true;
	]
	eval debug(rq.kernel);
	{
	for i := 0 to len(rq.shape) do
		eval debug("dim "+ntos(i)+": "+ntos_base(rq.shape[i], 16));
	for i := 0 to len(rq.args) do
		eval debug("arg "+ntos(i)+": "+ntos_base(rq.args[i], 16));
	for i := 0 to len(rq.arg_types) do
		eval debug("arg_type "+ntos(i)+": "+ntos_base(ord rq.arg_types[i], 16));
	for i := 0 to len(rq.arg_lengths) do
		eval debug("arg_length "+ntos(i)+": "+ntos_base(rq.arg_lengths[i], 16));
	for i := 0 to len(rq.arg_n_entries) do
		eval debug("arg_n_entries "+ntos(i)+": "+ntos_base(rq.arg_n_entries[i], 16));
	for i := 0 to len(rq.results_in) do
		eval debug("results_in "+ntos(i)+": "+rq.results_in[i]+".");
	for i := 0 to len(rq.results_out) do
		eval debug("results_out "+ntos(i)+": "+ntos_base(rq.results_out[i], 16));
	for i := 0 to len(rq.results_lengths) do
		eval debug("results_lengths "+ntos(i)+": "+ntos_base(rq.results_lengths[i], 16));
	}

	implicit var ctx := cl_mk_context(0);
	var prog := cl_mk_program(rq.kernel, "");
	if is_exception prog then [
		eval warning(rq.function_name + ": failed to create a program");
		goto failed;
	]

	var kernel := cl_mk_kernel(prog, "offload");
	if is_exception kernel then [
		eval warning(rq.function_name + ": failed to create a kernel");
		goto failed;
	]

	var arg_idx := 0;

	var err_buf := cl_mk_buffer(CL_MEM_WRITE_ONLY, 1, 0);
	cl_write_buffer(err_buf, 0, bytes.[ 0 ]);
	cl_kernel_arg_buffer(kernel, arg_idx, err_buf);
	arg_idx += 1;

	var results := empty(cl_buffer);
	for i := 0 to len(rq.results_lengths) do [
		var l := rq.results_lengths[i];
		var buf := cl_mk_buffer(CL_MEM_WRITE_ONLY, l, 0);
		results +<= buf;

		cl_kernel_arg_buffer(kernel, arg_idx, buf);
		arg_idx += 1;
	]

	var arg_buffers := empty(cl_buffer);
	for i := 0 to len(rq.args) do [
		var typ := rq.arg_types[i];
		if typ is t_void then [
			var buf := cl_mk_buffer(CL_MEM_READ_ONLY, rq.arg_lengths[i], 0);
			cl_write_buffer_raw(buf, 0, rq.args[i], rq.arg_lengths[i]);
			cl_kernel_arg_buffer(kernel, arg_idx, buf);
			arg_idx += 1;
			arg_buffers +<= buf;

			cl_kernel_arg(kernel, arg_idx, ffi_integer_type(true), rq.arg_n_entries[i]);
			arg_idx += 1;
		] else [
			cl_kernel_arg(kernel, arg_idx, typ, rq.args[i]);
			arg_idx += 1;
		]
	]

	var gwo := fill(0, len(rq.shape));
	var lws := fill(1, len(rq.shape));
	cl_enqueue_kernel(kernel, len(rq.shape), gwo, rq.shape, lws);
	if is_exception ctx then [
		eval warning(rq.function_name + ": failed to execute kernel");
		goto failed;
	]

	var exc := cl_read_buffer(err_buf, 0, 1);
	if exc[0] <> 0 then [
		eval warning(rq.function_name + ": the kernel returned an exception");
		goto failed;
	]

	for i := 0 to len(rq.results_lengths) do [
		var buf := results[i];
		cl_read_buffer_raw(buf, 0, rq.results_out[i], rq.results_lengths[i]);
		//eval debug("rq.results_out: " + ntos_base(rq.results_out[i], 16));
		//eval debug("rq.results_lengths: " + ntos(rq.results_lengths[i]));
		//var a, b := ffi_peek(unsafe_get_world, rq.results_out[i], ffi_type.t_sint64);
		//eval debug("value in buffer: " + ntos_base(b, 16));
	]

	xeval err_buf;
	xeval results;
	xeval arg_buffers;
	xeval ctx;

	eval debug("program finished (" + rq.function_name + ")");

	return false;

failed:
	for i := 0 to len(rq.results_in) do
		xeval ffi_poke_array(unsafe_get_world, rq.results_out[i], rq.results_in[i]);
	return true;
]
