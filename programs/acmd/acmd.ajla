uses main;

fn xxmain~strict(implicit w : world, d : dhandle, h : list(handle), args : list(bytes), env : treemap(bytes, bytes), prereq len(h) >= 3) : world
[
	xmain(w, d, h, args, env);
]

fn main
[
	fn f~weakspark := xmain;
	if not is_ready(f) then
		write(h[2], "compiling, please wait..." + nl);
	xeval f;
	xxmain(w, d, h, args, env);
]
