fn cl_mk_program(ctx : cl_context, code : bytes, options : bytes) : (cl_context, cl_program)
[
	implicit var w := ctx.w;
	implicit var destr := ffi_destructor_new();
	var ret err : int;

	var ptr_string := ffi_destructor_allocate(len(code), 1, false);
	ffi_poke_array(ptr_string, code);
	var ptr_strings := ffi_destructor_allocate(ffi_get_size(ffi_type.t_pointer), ffi_get_alignment(ffi_type.t_pointer), false);
	ffi_poke(ptr_strings, ffi_type.t_pointer, ptr_string);
	var ptr_sizes := ffi_destructor_allocate(ffi_get_size(ffi_type.t_usize), ffi_get_alignment(ffi_type.t_usize), false);
	ffi_poke(ptr_sizes, ffi_type.t_usize, len(code));
	var ptr_err_s32 := ffi_destructor_allocate(ffi_get_size(ffi_type.t_sint32), ffi_get_alignment(ffi_type.t_sint32), false);

	atomic_enter();
	ret, err := ffi_function_call(ctx.clCreateProgramWithSource, [ ctx.context, 1, ptr_strings, ptr_sizes, ptr_err_s32 ]);
	if ret = 0 then [
		atomic_exit();
		var e := ffi_peek(ptr_err_s32, ffi_type.t_sint32);
		ffi_destructor_destroy();
		xeval w;
		abort opencl_abort("clCreateProgramWithSource", e);
	]
	var prog := ret;
	ffi_destructor_call(destr, ctx.clReleaseProgram, [ prog ]);
	atomic_exit();

	ffi_destructor_free(ptr_string);
	ffi_destructor_free(ptr_strings);
	ffi_destructor_free(ptr_sizes);
	ffi_destructor_free(ptr_err_s32);

	var ptr_devices := ffi_destructor_allocate(ffi_get_size(ffi_type.t_pointer), ffi_get_alignment(ffi_type.t_pointer), false);
	ffi_poke(ptr_devices, ffi_type.t_pointer, ctx.device);
	var ptr_options := ffi_destructor_allocate(len(options) + 1, 1, false);
	ffi_poke_array(ptr_options, options);
	ffi_poke(ptr_options + len(options), ffi_type.t_schar, 0);

	ret, err := ffi_function_call(ctx.clBuildProgram, [ prog, 1, ptr_devices, ptr_options, 0, 0 ]);
	if ret <> 0 then [
		ffi_destructor_free(ptr_devices);
		ffi_destructor_free(ptr_options);

		var ptr_size := ffi_destructor_allocate(ffi_get_size(ffi_type.t_usize), ffi_get_alignment(ffi_type.t_usize), true);
		var ret2 : int;
		ret2, err := ffi_function_call(ctx.clGetProgramBuildInfo, [ prog, ctx.device, #1183, 0, 0, ptr_size ]);
		var size := ffi_peek(ptr_size, ffi_type.t_usize);

		if size > 0 then [
			var ptr_log := ffi_destructor_allocate(size, 1, false);
			ret2, err := ffi_function_call(ctx.clGetProgramBuildInfo, [ prog, ctx.device, #1183, size, ptr_log, ptr_size ]);
			if ret2 = 0 then [
				var log := ffi_peek_array(ptr_log, size, ffi_type.t_uchar, byte);
				eval warning(log);
			]
		]

		ffi_destructor_destroy();
		xeval w;
		abort opencl_abort("clBuildProgram", ret);
	]

	ffi_destructor_free(ptr_devices);
	ffi_destructor_free(ptr_options);

	var program := cl_program.[
		destr : destr,
		context : ctx.context,
		program : prog,
	];

	ctx.w := w;
	return ctx, program;
]

fn cl_mk_kernel(ctx : cl_context, program : cl_program, func : bytes) : (cl_context, cl_kernel)
[
	implicit var w := ctx.w;
	implicit var destr := ffi_destructor_new();
	var ret err : int;

	if ctx.context <> program.context then
		abort opencl_abort_msg("The program doesn't match the context");

	var ptr_func := ffi_destructor_allocate(len(func) + 1, 1, false);
	ffi_poke_array(ptr_func, func);
	ffi_poke(ptr_func + len(func), ffi_type.t_schar, 0);
	var ptr_err_s32 := ffi_destructor_allocate(ffi_get_size(ffi_type.t_sint32), ffi_get_alignment(ffi_type.t_sint32), false);

	atomic_enter();
	ret, err := ffi_function_call(ctx.clCreateKernel, [ program.program, ptr_func, ptr_err_s32 ]);
	if ret = 0 then [
		atomic_exit();
		var e := ffi_peek(ptr_err_s32, ffi_type.t_sint32);
		ffi_destructor_destroy();
		xeval w;
		abort opencl_abort("clCreateKernel", e);
	]
	var kern := ret;
	ffi_destructor_call(destr, ctx.clReleaseKernel, [ kern ]);
	atomic_exit();
	xeval program;

	ffi_destructor_free(ptr_func);
	ffi_destructor_free(ptr_err_s32);

	var kernel := cl_kernel.[
		destr : destr,
		context : ctx.context,
		kernel : kern,
		func : func,
	];

	ctx.w := w;
	return ctx, kernel;
]

fn cl_kernel_arg(ctx : cl_context, kernel : cl_kernel, arg : nat, ft : ffi_type, val : int) : cl_context
[
	implicit var w := ctx.w;
	implicit var destr := ffi_destructor_new();
	var ret err : int;

	if ctx.context <> kernel.context then
		abort opencl_abort_msg("The kernel doesn't match the context");

	var ptr_buffer := ffi_destructor_allocate(ffi_get_size(ft), ffi_get_alignment(ft), false);
	ffi_poke(ptr_buffer, ft, val);

	ret, err := ffi_function_call(ctx.clSetKernelArg, [ kernel.kernel, arg, ffi_get_size(ft), ptr_buffer ]);
	if ret <> 0 then [
		ffi_destructor_destroy();
		xeval w;
		abort opencl_abort("clSetKernelArg", ret);
	]
	xeval kernel;

	ffi_destructor_destroy();

	ctx.w := w;
	return ctx;
]

fn cl_kernel_arg_buffer(ctx : cl_context, kernel : cl_kernel, arg : nat, buffer : cl_buffer) : cl_context
[
	if ctx.context <> buffer.context then
		abort opencl_abort_msg("The kernel doesn't match the context");

	return cl_kernel_arg(ctx, kernel, arg, ffi_type.t_pointer, buffer.buffer);
]

fn cl_enqueue_kernel(ctx : cl_context, kernel : cl_kernel, dim : nat, gwo gws lws : list(nat)) : cl_context
[
	implicit var w := ctx.w;
	implicit var destr := ffi_destructor_new();
	var ret err : int;

	if ctx.context <> kernel.context then
		abort opencl_abort_msg("The kernel doesn't match the context");

	if dim <> len(gwo) or dim <> len(gws) or dim <> len(lws) then
		abort opencl_abort_msg("Invalid dimension");

	var ptr_gwo := ffi_destructor_allocate(ffi_get_size(ffi_type.t_usize) * dim, ffi_get_alignment(ffi_type.t_usize), false);
	ffi_poke_int_array(ptr_gwo, ffi_type.t_usize, gwo);
	var ptr_gws := ffi_destructor_allocate(ffi_get_size(ffi_type.t_usize) * dim, ffi_get_alignment(ffi_type.t_usize), false);
	ffi_poke_int_array(ptr_gws, ffi_type.t_usize, gws);
	var ptr_lws := ffi_destructor_allocate(ffi_get_size(ffi_type.t_usize) * dim, ffi_get_alignment(ffi_type.t_usize), false);
	ffi_poke_int_array(ptr_lws, ffi_type.t_usize, lws);

	var ptr_event := ffi_destructor_allocate(ffi_get_size(ffi_type.t_pointer), ffi_get_alignment(ffi_type.t_pointer), false);

	atomic_enter();
	ret, err := ffi_function_call(ctx.clEnqueueNDRangeKernel, [ ctx.command_queue, kernel.kernel, dim, ptr_gwo, ptr_gws, ptr_lws, 0, 0, ptr_event ]);
	if ret <> 0 then [
		atomic_exit();
		ffi_destructor_destroy();
		xeval w;
		abort opencl_abort("clEnqueueNDRangeKernel", ret);
	]
	var event := ffi_peek(ptr_event, ffi_type.t_pointer);
	ffi_destructor_call(destr, ctx.clReleaseEvent, [ event ]);

	if not ctx.callbacks then [
		ret, err := ffi_function_call(ctx.clWaitForEvents, [ 1, ptr_event ]);
		if ret <> 0 then [
			atomic_exit();
			ffi_destructor_destroy();
			xeval w;
			abort opencl_abort("clWaitForEvents", ret);
		]
	] else [
		var callback, callback_ptr := ffi_callback_create();
		ret, err := ffi_function_call(ctx.clSetEventCallback, [ event, 0, callback_ptr, 0 ]);
		if ret <> 0 then [
			ffi_callback_cancel(callback);
			atomic_exit();
			ffi_destructor_destroy();
			xeval w;
			abort opencl_abort("clSetEventCallback", ret);
		]
		ffi_callback_wait(callback);
	]

	atomic_exit();

	var ptr_status := ffi_destructor_allocate(ffi_get_size(ffi_type.t_sint32), ffi_get_alignment(ffi_type.t_sint32), false);

	ret, err := ffi_function_call(ctx.clGetEventInfo, [ event, #11D3, ffi_get_size(ffi_type.t_sint32), ptr_status, 0 ]);
	if ret <> 0 then [
		ffi_destructor_destroy();
		xeval w;
		abort opencl_abort("clGetEventInfo", ret);
	]

	var status := ffi_peek(ptr_status, ffi_type.t_sint32);
	if status < 0 then [
		ffi_destructor_destroy();
		xeval w;
		abort opencl_abort(kernel.func, ret);
	];

	xeval kernel;
	ffi_destructor_destroy();

	ctx.w := w;
	return ctx;
]
