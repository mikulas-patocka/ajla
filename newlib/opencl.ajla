unit opencl;

uses ffi;

type cl_context;
type cl_buffer;
type cl_program;
type cl_kernel;

fn cl_mk_context(num : nat) : cl_context;
fn cl_get_device_info_value(ctx : cl_context, param : nat, ft : ffi_type) : (cl_context, int);
fn cl_get_device_info_string(ctx : cl_context, param : nat) : (cl_context, bytes);
fn cl_get_version(ctx : cl_context) : nat;

const CL_MEM_READ_WRITE :=	1 shl 0;
const CL_MEM_WRITE_ONLY :=	1 shl 1;
const CL_MEM_READ_ONLY :=	1 shl 2;
const CL_MEM_USE_HOST_PTR :=	1 shl 3;
const CL_MEM_ALLOC_HOST_PTR :=	1 shl 4;
const CL_MEM_COPY_HOST_PTR :=	1 shl 5;
const CL_MEM_HOST_WRITE_ONLY :=	1 shl 7;
const CL_MEM_HOST_READ_ONLY :=	1 shl 8;
const CL_MEM_HOST_NO_ACCESS :=	1 shl 9;
fn cl_mk_buffer(ctx : cl_context, access : nat, size : nat, host_ptr : int) : (cl_context, cl_buffer);
fn cl_read_buffer_raw(ctx : cl_context, buf : cl_buffer, offset ptr size : nat) : cl_context;
fn cl_read_buffer(ctx : cl_context, buf : cl_buffer, offset size : nat) : (cl_context, bytes);
fn cl_write_buffer_raw(ctx : cl_context, buf : cl_buffer, offset ptr size : nat) : cl_context;
fn cl_write_buffer(ctx : cl_context, buf : cl_buffer, offset : nat, data : bytes) : cl_context;

fn cl_mk_program(ctx : cl_context, code : bytes, options : bytes) : (cl_context, cl_program);
fn cl_mk_kernel(ctx : cl_context, program : cl_program, func : bytes) : (cl_context, cl_kernel);
fn cl_kernel_arg(ctx : cl_context, kernel : cl_kernel, arg : nat, ft : ffi_type, val : int) : cl_context;
fn cl_kernel_arg_buffer(ctx : cl_context, kernel : cl_kernel, arg : nat, buffer : cl_buffer) : cl_context;
fn cl_enqueue_kernel(ctx : cl_context, kernel : cl_kernel, dim : nat, gwo gws lws : list(nat)) : cl_context;

implementation

uses exception;

record cl_context [
	w : world;
	destr : ffi_destructor;

	version : nat;
	device : int;
	context : int;
	command_queue : int;

	callbacks : bool;

	clGetDeviceInfo : ffi_function;
	clCreateBuffer : ffi_function;
	clReleaseMemObject : ffi_function;
	clEnqueueReadBuffer : ffi_function;
	clEnqueueWriteBuffer : ffi_function;
	clCreateProgramWithSource : ffi_function;
	clReleaseProgram : ffi_function;
	clBuildProgram : ffi_function;
	clGetProgramBuildInfo : ffi_function;
	clCreateKernel : ffi_function;
	clReleaseKernel : ffi_function;
	clSetKernelArg : ffi_function;
	clEnqueueNDRangeKernel : ffi_function;
	clReleaseEvent : ffi_function;
	clWaitForEvents : ffi_function;
	clGetEventInfo : ffi_function;
	clSetEventCallback : ffi_function;
]

record cl_buffer [
	destr : ffi_destructor;
	context : int;
	buffer : int;
]

record cl_program [
	destr : ffi_destructor;
	context : int;
	program : int;
]

record cl_kernel [
	destr : ffi_destructor;
	context : int;
	kernel : int;
	func : bytes;
]

fn opencl_abort(func : bytes, retval : int) : cl_context
[
	abort exception_make_str(cl_context, ec_library, error_invalid_operation, -retval, true, "function " + func + " failed: " + ntos(retval));
]

fn opencl_abort_msg(b : bytes) : cl_context
[
	abort exception_make_str(cl_context, ec_library, error_invalid_operation, 0, true, "OpenCL failed: " + b);
]

fn probe_device(implicit w : world, lib : ffi_library, d : int) : (world, bool)
[
	implicit var destr := ffi_destructor_new();
	var ret err : int;

	var clCreateContext := ffi_function_create(lib, "clCreateContext", ffi_error.e_none, 0, ffi_type.t_pointer, [ ffi_type.t_pointer, ffi_type.t_uint32, ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_pointer ]);
	var clReleaseContext := ffi_function_create(lib, "clReleaseContext", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_pointer ]);

	var ptr_devices := ffi_destructor_allocate(ffi_get_size(ffi_type.t_pointer), ffi_get_alignment(ffi_type.t_pointer), false);
	ffi_poke(ptr_devices, ffi_type.t_pointer, d);
	var ptr_err_s32 := ffi_destructor_allocate(ffi_get_size(ffi_type.t_sint32), ffi_get_alignment(ffi_type.t_sint32), false);

	atomic_enter();
	ret, err := ffi_function_call(clCreateContext, [ 0, 1, ptr_devices, 0, 0, ptr_err_s32 ]);
	if ret = 0 then [
		atomic_exit();
		return false;
	]
	var ctx := ret;
	ffi_destructor_call(destr, clReleaseContext, [ ctx ]);
	atomic_exit();

	var clCreateProgramWithSource := ffi_function_create(lib, "clCreateProgramWithSource", ffi_error.e_none, 0, ffi_type.t_pointer, [ ffi_type.t_pointer, ffi_type.t_uint32, ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_pointer ]);
	var clReleaseProgram := ffi_function_create(lib, "clReleaseProgram", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_pointer ]);

	var code := "__kernel void render(void) { }";

	var ptr_string := ffi_destructor_allocate(len(code), 1, false);
	ffi_poke_array(ptr_string, code);
	var ptr_strings := ffi_destructor_allocate(ffi_get_size(ffi_type.t_pointer), ffi_get_alignment(ffi_type.t_pointer), false);
	ffi_poke(ptr_strings, ffi_type.t_pointer, ptr_string);
	var ptr_sizes := ffi_destructor_allocate(ffi_get_size(ffi_type.t_usize), ffi_get_alignment(ffi_type.t_usize), false);
	ffi_poke(ptr_sizes, ffi_type.t_usize, len(code));

	atomic_enter();
	ret, err := ffi_function_call(clCreateProgramWithSource, [ ctx, 1, ptr_strings, ptr_sizes, ptr_err_s32 ]);
	if ret = 0 then [
		//var e := ffi_peek(ptr_err_s32, ffi_type.t_sint32);
		//ffi_destructor_destroy();
		//eval debug("returned 1: " + ntos(e));
		atomic_exit();
		return false;
	]
	var prog := ret;
	ffi_destructor_call(destr, clReleaseProgram, [ prog ]);
	atomic_exit();
	ffi_destructor_free(ptr_string);
	ffi_destructor_free(ptr_strings);
	ffi_destructor_free(ptr_sizes);

	var clBuildProgram := ffi_function_create(lib, "clBuildProgram", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_pointer, ffi_type.t_uint32, ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_pointer ]);

	ret, err := ffi_function_call(clBuildProgram, [ prog, 1, ptr_devices, 0, 0, 0 ]);
	if ret <> 0 then [
		//eval debug("returned 2: " + ntos(ret));
		return false;
	]

	ffi_destructor_free(ptr_devices);
	ffi_destructor_free(ptr_err_s32);
	ffi_destructor_destroy();

	return true;
]

fn cl_get_device_info_value(ctx : cl_context, param : nat, ft : ffi_type) : (cl_context, int)
[
	implicit var w := ctx.w;
	implicit var destr := ffi_destructor_new();
	var ret err : int;
	var result : int;

	var ptr_value := ffi_destructor_allocate(ffi_get_size(ft), ffi_get_alignment(ft), false);
	ret, err := ffi_function_call(ctx.clGetDeviceInfo, [ ctx.device, param, ffi_get_size(ft), ptr_value, 0 ]);
	if ret <> 0 then [
		result := -1;
	] else [
		result := ffi_peek(ptr_value, ft);
	]

	ffi_destructor_destroy();

	ctx.w := w;
	return ctx, result;
]

fn cl_get_version(ctx : cl_context) : nat
[
	return ctx.version;
]

fn cl_get_device_info_string(ctx : cl_context, param : nat) : (cl_context, bytes)
[
	implicit var w := ctx.w;
	implicit var destr := ffi_destructor_new();
	var ret err : int;
	var result : bytes;

	var ptr_n_size := ffi_destructor_allocate(ffi_get_size(ffi_type.t_usize), ffi_get_alignment(ffi_type.t_usize), false);
	ret, err := ffi_function_call(ctx.clGetDeviceInfo, [ ctx.device, param, 0, 0, ptr_n_size ]);
	if ret <> 0 then [
		result := "";
		goto ret;
	]
	var l := ffi_peek(ptr_n_size, ffi_type.t_usize);

	var ptr_string := ffi_destructor_allocate(l, 1, false);
	ret, err := ffi_function_call(ctx.clGetDeviceInfo, [ ctx.device, param, l, ptr_string, ptr_n_size ]);
	var l2 := ffi_peek(ptr_n_size, ffi_type.t_usize);
	if l <> l2 then
		abort opencl_abort_msg("Parameter " + ntos(param) + " length mismatch: " + ntos(l) + " <> " + ntos(l2));
	//var result := ffi_peek_array(ptr_string, l, ffi_type.t_uchar, byte);
	result := ffi_peek_zstring(ptr_string);

ret:
	ffi_destructor_destroy();

	ctx.w := w;
	return ctx, result;
]

fn cl_mk_context(num : nat) : cl_context
[
	implicit var w := unsafe_get_world;
	implicit var destr := ffi_destructor_new();
	var ret err : int;

	var lib := ffi_open_library("OpenCL", true, "");
	xeval lib;

	var clGetPlatformIDs := ffi_function_create_with_flags(lib, "clGetPlatformIDs", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_uint32, ffi_type.t_pointer, ffi_type.t_pointer ], ffi_flag_block_signals);
	var ptr_n_u32 := ffi_destructor_allocate(ffi_get_size(ffi_type.t_uint32), ffi_get_alignment(ffi_type.t_uint32), false);
	ret, err := ffi_function_call(clGetPlatformIDs, [ 0, 0, ptr_n_u32 ]);
	if ret <> 0 then
		abort opencl_abort("clGetPlatformIDs", ret);
	var n_platforms := ffi_peek(ptr_n_u32, ffi_type.t_uint32);
	if n_platforms = 0 then
		abort opencl_abort_msg("No platforms");

	var ptr_platforms := ffi_destructor_allocate(ffi_get_size(ffi_type.t_pointer) * n_platforms, ffi_get_alignment(ffi_type.t_pointer), false);
	ret, err := ffi_function_call(clGetPlatformIDs, [ n_platforms, ptr_platforms, ptr_n_u32 ]);
	if ret <> 0 then
		abort opencl_abort("clGetPlatformIDs", ret);

	var n2 := ffi_peek(ptr_n_u32, ffi_type.t_uint32);
	n_platforms := min(n_platforms, n2);
	if n_platforms = 0 then
		abort opencl_abort_msg("No platforms");
	var platforms := ffi_peek_int_array(ptr_platforms, n_platforms, ffi_type.t_pointer);

	ffi_destructor_free(ptr_platforms);

	//eval debug("n_platforms: " + ntos(n_platforms));
	//for i := 0 to len(platforms) do eval debug("platform: " + ntos_base(platforms[i], 16));

	var device_types := [ 4, 8, 2 ];	// GPU, accelerator, CPU

	var clGetDeviceIDs := ffi_function_create_with_flags(lib, "clGetDeviceIDs", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_pointer, ffi_type.t_ulong, ffi_type.t_uint, ffi_type.t_pointer, ffi_type.t_pointer ], ffi_flag_block_signals);

	var devices := empty(int);

	for dt in device_types do [
		for p := 0 to len(platforms) do [
			ret, err := ffi_function_call(clGetDeviceIDs, [ platforms[p], dt, 0, 0, ptr_n_u32 ]);
			if ret <> 0 then
				continue;
			var n_devices := ffi_peek(ptr_n_u32, ffi_type.t_uint32);
			if n_devices = 0 then
				continue;

			var ptr_devices := ffi_destructor_allocate(ffi_get_size(ffi_type.t_pointer) * n_devices, ffi_get_alignment(ffi_type.t_pointer), false);
			ret, err := ffi_function_call(clGetDeviceIDs, [ platforms[p], dt, n_devices, ptr_devices, ptr_n_u32 ]);
			if ret <> 0 then [
				ffi_destructor_free(ptr_devices);
				continue;
			]

			n2 := ffi_peek(ptr_n_u32, ffi_type.t_uint32);
			n_devices := min(n_devices, n2);
			var devs := ffi_peek_int_array(ptr_devices, n_devices, ffi_type.t_pointer);
			devices += devs;
			ffi_destructor_free(ptr_devices);
		]
	]

	ffi_destructor_free(ptr_n_u32);

	if len(devices) = 0 then
		abort opencl_abort_msg("No devices");

	//for i := 0 to len(devices) do eval debug("device: " + ntos_base(devices[i], 16));

	implicit var ctx := cl_context.[
		w : w,
	];

	for i := 0 to len(devices) do [
		var b := probe_device(lib, devices[i]);
		if b then [
			if num > 0 then [
				num -= 1;
				continue;
			]
			//eval debug("valid device: " + ntos(i));
			ctx.device := devices[i];
			goto found;
		]
	]
	abort opencl_abort_msg("No more devices");

found:
	ffi_destructor_destroy();
	destr := ffi_destructor_new();

	ctx.clGetDeviceInfo := ffi_function_create(lib, "clGetDeviceInfo", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_pointer, ffi_type.t_uint32, ffi_type.t_usize, ffi_type.t_pointer, ffi_type.t_pointer ]);

	//var name := cl_get_device_info_string(ctx, #102B);
	//eval debug("using device " + name);

	var version := cl_get_device_info_string(ctx, #102F);
	var wh_version := list_break_whitespace(version);
	if len(wh_version) < 2 then
		abort opencl_abort_msg("Invalid version: " + version);
	if wh_version[0] <> "OpenCL" then
		abort opencl_abort_msg("Not OpenCL: " + version);
	var mm_version := list_break(wh_version[1], '.');
	ctx.version := ston(mm_version[0]) * 100 + ston(mm_version[1]);
	if is_exception ctx.version then
		abort opencl_abort_msg("Invalid version: " + version);
	//eval debug("version: " + ntos(ctx.version));

	ctx.callbacks := ctx.version >= 101;

	var ooo_queue := false;
	var queue_flags := cl_get_device_info_value(ctx, #102A, ffi_type.t_ulong);
	if queue_flags >= 0 then [
		ooo_queue := queue_flags bt 0;
		//eval debug("ooo_queue: " + select(ooo_queue, "0", "1"));
	]

	var clCreateContext := ffi_function_create(lib, "clCreateContext", ffi_error.e_none, 0, ffi_type.t_pointer, [ ffi_type.t_pointer, ffi_type.t_uint32, ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_pointer ]);
	var clReleaseContext := ffi_function_create(lib, "clReleaseContext", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_pointer ]);

	var ptr_devices := ffi_destructor_allocate(ffi_get_size(ffi_type.t_pointer), ffi_get_alignment(ffi_type.t_pointer), false);
	ffi_poke(ptr_devices, ffi_type.t_pointer, ctx.device);
	var ptr_err_s32 := ffi_destructor_allocate(ffi_get_size(ffi_type.t_sint32), ffi_get_alignment(ffi_type.t_sint32), false);

	atomic_enter();
	ret, err := ffi_function_call(clCreateContext, [ 0, 1, ptr_devices, 0, 0, ptr_err_s32 ]);
	if ret = 0 then [
		atomic_exit();
		var e := ffi_peek(ptr_err_s32, ffi_type.t_sint32);
		ffi_destructor_destroy();
		xeval w;
		abort opencl_abort("clCreateContext", e);
	]
	ctx.context := ret;
	ffi_destructor_call(destr, clReleaseContext, [ ctx.context ]);
	atomic_exit();
	ffi_destructor_free(ptr_devices);

	var clCreateCommandQueue := ffi_function_create(lib, "clCreateCommandQueue", ffi_error.e_none, 0, ffi_type.t_pointer, [ ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_ulong, ffi_type.t_pointer ]);
	var clReleaseCommandQueue := ffi_function_create(lib, "clReleaseCommandQueue", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_pointer ]);

	atomic_enter();
	ret, err := ffi_function_call(clCreateCommandQueue, [ ctx.context, ctx.device, select(ooo_queue, 0, 1), ptr_err_s32 ]);
	if ret = 0 then [
		atomic_exit();
		var e := ffi_peek(ptr_err_s32, ffi_type.t_sint32);
		ffi_destructor_destroy();
		xeval w;
		abort opencl_abort("clCreateCommandQueue", e);
	]
	ctx.command_queue := ret;
	ffi_destructor_call(destr, clReleaseCommandQueue, [ ctx.command_queue ]);
	atomic_exit();

	ffi_destructor_free(ptr_err_s32);

	ctx.clCreateBuffer := ffi_function_create(lib, "clCreateBuffer", ffi_error.e_none, 0, ffi_type.t_pointer, [ ffi_type.t_pointer, ffi_type.t_ulong, ffi_type.t_usize, ffi_type.t_pointer, ffi_type.t_pointer ]);
	ctx.clReleaseMemObject := ffi_function_create(lib, "clReleaseMemObject", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_pointer ]);
	ctx.clEnqueueReadBuffer := ffi_function_create(lib, "clEnqueueReadBuffer", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_uint32, ffi_type.t_usize, ffi_type.t_usize, ffi_type.t_pointer, ffi_type.t_uint32, ffi_type.t_pointer, ffi_type.t_pointer ]);
	ctx.clEnqueueWriteBuffer := ffi_function_create(lib, "clEnqueueWriteBuffer", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_uint32, ffi_type.t_usize, ffi_type.t_usize, ffi_type.t_pointer, ffi_type.t_uint32, ffi_type.t_pointer, ffi_type.t_pointer ]);

	ctx.clCreateProgramWithSource := ffi_function_create(lib, "clCreateProgramWithSource", ffi_error.e_none, 0, ffi_type.t_pointer, [ ffi_type.t_pointer, ffi_type.t_uint32, ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_pointer ]);
	ctx.clReleaseProgram := ffi_function_create(lib, "clReleaseProgram", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_pointer ]);
	ctx.clBuildProgram := ffi_function_create(lib, "clBuildProgram", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_pointer, ffi_type.t_uint32, ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_pointer ]);
	ctx.clGetProgramBuildInfo := ffi_function_create(lib, "clGetProgramBuildInfo", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_uint32, ffi_type.t_usize, ffi_type.t_pointer, ffi_type.t_pointer ]);

	ctx.clCreateKernel := ffi_function_create(lib, "clCreateKernel", ffi_error.e_none, 0, ffi_type.t_pointer, [ ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_pointer ]);
	ctx.clReleaseKernel := ffi_function_create(lib, "clReleaseKernel", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_pointer ]);
	ctx.clSetKernelArg := ffi_function_create(lib, "clSetKernelArg", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_pointer, ffi_type.t_uint32, ffi_type.t_usize, ffi_type.t_pointer ]);

	ctx.clEnqueueNDRangeKernel := ffi_function_create(lib, "clEnqueueNDRangeKernel", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_uint32, ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_pointer, ffi_type.t_uint32, ffi_type.t_pointer, ffi_type.t_pointer ]);

	ctx.clReleaseEvent := ffi_function_create(lib, "clReleaseEvent", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_pointer ]);
	ctx.clWaitForEvents := ffi_function_create(lib, "clWaitForEvents", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_uint32, ffi_type.t_pointer ]);
	ctx.clGetEventInfo := ffi_function_create(lib, "clGetEventInfo", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_pointer, ffi_type.t_uint32, ffi_type.t_usize, ffi_type.t_pointer, ffi_type.t_pointer ]);
	if ctx.callbacks then [
		ctx.clSetEventCallback := ffi_function_create(lib, "clSetEventCallback", ffi_error.e_none, 0, ffi_type.t_sint32, [ ffi_type.t_pointer, ffi_type.t_sint32, ffi_type.t_pointer, ffi_type.t_pointer ]);
		if is_exception ctx.clSetEventCallback then
			ctx.callbacks := false;
	]

	ctx.destr := destr;

	ctx.w := w;
	return ctx;
]

fn cl_mk_buffer(ctx : cl_context, access : nat, size : nat, host_ptr : int) : (cl_context, cl_buffer)
[
	implicit var w := ctx.w;
	implicit var destr := ffi_destructor_new();
	var ret err : int;

	if ctx.version < 102 then [
		access and= not (CL_MEM_HOST_WRITE_ONLY or CL_MEM_HOST_READ_ONLY or CL_MEM_HOST_NO_ACCESS);
	]

	var ptr_err_s32 := ffi_destructor_allocate(ffi_get_size(ffi_type.t_sint32), ffi_get_alignment(ffi_type.t_sint32), false);

	atomic_enter();
	ret, err := ffi_function_call(ctx.clCreateBuffer, [ ctx.context, access, size, host_ptr, ptr_err_s32 ]);
	if ret = 0 then [
		atomic_exit();
		var e := ffi_peek(ptr_err_s32, ffi_type.t_sint32);
		ffi_destructor_destroy();
		xeval w;
		abort opencl_abort("clCreateBuffer", e);
	]
	ffi_destructor_call(destr, ctx.clReleaseMemObject, [ ret ]);
	atomic_exit();

	ffi_destructor_free(ptr_err_s32);

	var buf := cl_buffer.[
		destr : destr,
		context : ctx.context,
		buffer : ret,
	];

	ctx.w := w;
	return ctx, buf;
]

fn cl_read_buffer_raw(ctx : cl_context, buf : cl_buffer, offset ptr size : nat) : cl_context
[
	implicit var w := ctx.w;
	implicit var destr := ffi_destructor_new();
	var ret err : int;

	if ctx.context <> buf.context then
