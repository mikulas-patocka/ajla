private unit compiler.optimize.offload;

uses compiler.optimize.defs;

fn offload(ctx : context) : context;

implementation

uses compiler.optimize.utils;

fn skip_empty(ctx : context, bgi : int) : int
[
again:
	var block := ctx.blocks[bgi];
	for i := 0 to len(block.instrs) do
		if ctx.instrs[block.instrs[i]].opcode <> P_Line_Info then
			return bgi;
	bgi := block.post_list[0];
	goto again;
]

fn get_phis(ctx : context, bgi : int) : list(instruction)
[
	var block := ctx.blocks[bgi];
	var result := empty(instruction);
	for i := 0 to len(block.instrs) do [
		var instr := ctx.instrs[block.instrs[i]];
		if instr.opcode <> P_Phi then
			break;
		result +<= instr;
	]
	return result;
]

fn last_instr(ctx : context, bgi : int) : instruction
[
	var block := ctx.blocks[bgi];
	if len(block.post_list) <> 3 then
		abort internal("last_instr is not P_Jmp_False");
	return ctx.instrs[block.instrs[len(block.instrs) - 1]];
]

option loop_limit [
	v : int;
	c : int;
	a : int;
]

record loop_status [
	control_variable : int;
	added_control_variable : int;
	limit : loop_limit;
	body_bb : int;
	end_bb : int;
]

fn test_loop(ctx : context, start_bgi end_bgi : int) : list(loop_status)
[
	eval debug("test_loop: " + ntos(start_bgi) + ", " + ntos(end_bgi));

	var start_block := ctx.blocks[start_bgi];
	var test_bgi : int;
	if len(start_block.post_list) = 1 then [
		test_bgi := start_block.post_list[0];
	] else if len(start_block.post_list) = 3 then [
		test_bgi := start_bgi;
	] else [
		return empty(loop_status);
	]
	var test_block := ctx.blocks[test_bgi];

	if len(test_block.pred_list) <> 2 then
		return empty(loop_status);
	if len(test_block.post_list) <> 3 then
		return empty(loop_status);
	if skip_empty(ctx, test_block.post_list[1]) <> skip_empty(ctx, end_bgi) then
		return empty(loop_status);

	var skip_instr := last_instr(ctx, test_bgi);
	var bool_var := ctx.variables[skip_instr.params[0]];
	var cmp_instr := ctx.instrs[bool_var.defining_instr];
	if cmp_instr.bb <> test_bgi then
		return empty(loop_status);

	var control_var : int;
	var lim : loop_limit;
	if cmp_instr.opcode = P_BinaryOp then [
		control_var := cmp_instr.params[3];
		lim := loop_limit.v.(cmp_instr.params[5]);
	] else if cmp_instr.opcode = P_BinaryConstOp then [
		control_var := cmp_instr.params[3];
		lim := loop_limit.c.(cmp_instr.params[4]);
	] else if cmp_instr.opcode = P_Array_Len_Greater_Than then [
		control_var := cmp_instr.params[2];
		lim := loop_limit.a.(cmp_instr.params[1]);
	] else [
		return empty(loop_status);
	]

	var test_phis := get_phis(ctx, test_bgi);

	var var0, var1 := -1, -1;
	for i := 0 to len(test_phis) do [
		if test_phis[i].params[0] = control_var then [
			var0 := test_phis[i].params[1];
			var1 := test_phis[i].params[2];
			var def0 := ctx.instrs[ctx.variables[var0].defining_instr];
			var def1 := ctx.instrs[ctx.variables[var1].defining_instr];
			if def0.opcode = P_Load_Const, len(def0.params) = 2 then [
			] else if def1.opcode = P_Load_Const, len(def1.params) = 2 then [
				var0, var1 := var1, var0;
				def0, def1 := def1, def0;
			] else [
				return empty(loop_status);
			]
		]
	]
	if var1 = -1 then
		return empty(loop_status);
	var def1 := ctx.instrs[ctx.variables[var1].defining_instr];
	if def1.opcode <> P_BinaryConstOp then
		return empty(loop_status);
	if def1.params[0] <> Bin_Add or
	   def1.params[3] <> control_var or
	   def1.params[4] <> 1 then
		return empty(loop_status);

	var last_bb := def1.bb;
	if len(ctx.blocks[last_bb].post_list) <> 1 then
		return empty(loop_status);
	if ctx.blocks[last_bb].post_list[0] <> test_bgi then
		return empty(loop_status);

	var qq := test_loop(ctx, test_block.post_list[0], last_bb);

	return [ loop_status.[
		control_variable : control_var,
		added_control_variable : var1,
		limit : lim,
		body_bb : test_block.post_list[0],
		end_bb : last_bb,
	] ] + qq;
]

fn offload_instruction(ctx : context, ili : int, ins : instruction) : instruction
[
	var decision_bgi := ins.bb;
	var decision_block := ctx.blocks[decision_bgi];
	var decision_insn := ctx.instrs[decision_block.instrs[len(decision_block.instrs) - 1]];
	if decision_insn.opcode <> P_Jmp_False then [
		eval debug(ctx.name + ": decision block doesn't end with conditional jump");
		goto fail;
	]
	if decision_insn.params[0] <> ins.params[0] then [
		eval debug(ctx.name + ": decision block end doesn't correspond with offload instruction");
		goto fail;
	]
	var loop_bgi := decision_block.post_list[0];
	var end_bgi := decision_block.post_list[1];

	var shape := test_loop(ctx, loop_bgi, end_bgi);
	if len(shape) = 0 then [
		eval debug(ctx.name + ": loop doesn't have appropriate shape");
		goto fail;
	]
	if len(shape) > 3 then [
		eval debug(ctx.name + ": more than 3 dimensions");
		goto fail;
	]
	eval debug("loop recognized, dim: " + ntos(len(shape)));

fail:
	return ins;
]

fn offload(ctx : context) : context
[
	eval dump_basic_blocks(ctx, true);
	var n_blocks := len(ctx.blocks);
	for bgi := 0 to n_blocks do [
		var block := ctx.blocks[bgi];
		if not block.active then
			continue;
		var l := len(block.instrs);
		for ili := 0 to l do [
			var igi := ctx.blocks[bgi].instrs[ili];
			var ins := ctx.instrs[igi];
			if ins.opcode = P_Offload then [
				ins := offload_instruction(ctx, ili, ins);
				ctx.instrs[igi] := ins;
			]
		]
	]
	return ctx;
]
